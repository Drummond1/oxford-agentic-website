---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import BackToTop from '../components/BackToTop.astro';
import config from '../../site.config';
import { breadcrumbSchema } from '../lib/schema';

interface Props {
  /** Page name only — the brand suffix is applied here, never in the page. */
  pageTitle: string;
  /** Set when a page needs a bespoke <title> (events use a dated pattern). */
  titleOverride?: string;
  description: string;
  path: string;
  ogImage?: string;
  schemaNodes?: Array<Record<string, unknown> | null>;
  breadcrumbs?: Array<{ name: string; path: string }>;
  /** Set on long-form pages so crawlers read them as articles, not brochure pages. */
  article?: { publishedTime: Date; modifiedTime: Date; author?: string };
  noindex?: boolean;
  bodyClass?: string;
}

const {
  pageTitle,
  titleOverride,
  description,
  path,
  ogImage,
  schemaNodes = [],
  breadcrumbs = [],
  article,
  noindex = false,
  bodyClass = '',
} = Astro.props;

// PRD §12 title pattern. The brand string comes from config, so a rename
// rewrites every <title> on the site in one build.
const title = titleOverride ?? `${pageTitle} - ${config.brand.name}`;

const trail = [{ name: 'Home', path: '/' }, ...breadcrumbs];
const nodes = [...schemaNodes, trail.length > 1 ? breadcrumbSchema(trail) : null];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      schemaNodes={nodes}
      article={article}
      noindex={noindex}
    />
  </head>
  <body class={bodyClass}>
    {/* Reading progress on long-form pages only; decorative, so hidden from AT. */}
    {article && <div class="progress" data-progress aria-hidden="true"></div>}
    {
      /* GTM's no-JS fallback. It has to be the first thing in the body per
         Google's spec. It fires nothing that consent gates, because with JS off
         there is no consent UI to gate it. */
      config.analytics.provider === 'gtm' && (
        <noscript
          set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${config.analytics.siteId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`}
        />
      )
    }
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      {trail.length > 1 && <Breadcrumbs trail={trail} />}
      <slot />
    </main>
    <Footer />
    <BackToTop />
    {config.analytics.provider === 'gtm' && config.analytics.requireConsent !== false && <ConsentBanner />}

    <script>
      // Motion: fade/slide-up once on scroll. The class is added by JS, so with
      // JS off (or IntersectionObserver missing) content is simply visible.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal]');

      if (!reduced && 'IntersectionObserver' in window && targets.length > 0) {
        document.documentElement.classList.add('js-motion');

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              const delay = Number(el.dataset.revealDelay ?? 0);
              window.setTimeout(() => el.classList.add('is-revealed'), delay);
              observer.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );

        targets.forEach((el) => observer.observe(el));

        // Keyboard safety net: tabbing into a not-yet-revealed block reveals it
        // permanently, so focus never rests on invisible content.
        document.addEventListener(
          'focusin',
          (event) => {
            const block = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-reveal]');
            if (!block || block.classList.contains('is-revealed')) return;
            block.classList.add('is-revealed');
            observer.unobserve(block);
          },
          true,
        );
      }

      // Stat tiles count up once as they scroll into view (PRD §10). The final
      // value is already in the HTML, so it is correct before, during and
      // without JS — the animation only ever replaces it temporarily.
      if (!reduced && 'IntersectionObserver' in window) {
        const stats = document.querySelectorAll<HTMLElement>('.stat__value');

        const countObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              countObserver.unobserve(el);

              const final = (el.textContent ?? '').trim();
              const target = Number(final.replace(/[^0-9.]/g, ''));
              // Only animate plain numbers; anything else stays as authored.
              if (!Number.isFinite(target) || target <= 0 || !/^[0-9]+$/.test(final)) continue;

              const duration = 900;
              const start = performance.now();
              const tick = (now: number) => {
                const p = Math.min((now - start) / duration, 1);
                // Ease-out so it settles rather than stopping dead.
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = String(Math.round(target * eased));
                if (p < 1) requestAnimationFrame(tick);
                else el.textContent = final;
              };
              requestAnimationFrame(tick);
            }
          },
          { threshold: 0.6 },
        );

        stats.forEach((el) => countObserver.observe(el));
      }

      // Reading progress: a hairline of amber tracking how far down a long
      // article the reader is. Passive listener, transform-only, so it never
      // costs a layout.
      const progress = document.querySelector<HTMLElement>('[data-progress]');
      if (progress && !reduced) {
        // `scrollHeight` forces a reflow, so it is measured on resize only and
        // cached; the scroll handler then does arithmetic and nothing else.
        let max = 0;
        let ticking = false;

        const measure = () => {
          max = document.documentElement.scrollHeight - window.innerHeight;
        };

        const paint = () => {
          const ratio = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
          progress.style.transform = `scaleX(${ratio})`;
          ticking = false;
        };

        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(paint);
        };

        measure();
        paint();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', () => {
          measure();
          paint();
        }, { passive: true });
      }

      // Analytics is provider-agnostic: components declare intent with
      // data-analytics-event and this dispatches to whichever provider is on.
      type Props = Record<string, string>;

      function track(name: string, props: Props = {}) {
        const w = window as unknown as {
          plausible?: (n: string, o?: { props: Props }) => void;
          gtag?: (...args: unknown[]) => void;
        };
        w.plausible?.(name, { props });
        w.gtag?.('event', name, props);
      }

      document.addEventListener('click', (event) => {
        const el = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-analytics-event]');
        if (!el) return;
        track(el.dataset.analyticsEvent!, el.dataset.analyticsSlug ? { event_slug: el.dataset.analyticsSlug } : {});
      });

      // We cannot see inside the Luma iframe, so registration intent is measured
      // three ways (PRD §9.6): section-in-view, iframe interaction, outbound click.
      const registerSection = document.querySelector<HTMLElement>('[data-register-section]');
      if (registerSection && 'IntersectionObserver' in window) {
        const slug = registerSection.dataset.eventSlug ?? '';
        const seen = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            track('register_section_viewed', { event_slug: slug });
            seen.disconnect();
          },
          { threshold: 0.4 },
        );
        seen.observe(registerSection);

        // A focus shift into the iframe is the only reliable signal that
        // someone started interacting with the embed.
        let counted = false;
        window.addEventListener('blur', () => {
          if (counted) return;
          if (document.activeElement?.tagName !== 'IFRAME') return;
          counted = true;
          track('luma_embed_interacted', { event_slug: slug });
        });
      }
    </script>
  </body>
</html>

---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import config from '../../../site.config';
import { formatShortDate, getEventsForProgramme, getProgrammes, paths } from '../../lib/site';
import { ogPathFor } from '../../lib/og';
import { collectionPageSchema } from '../../lib/schema';

const programmes = await getProgrammes();

const rows = await Promise.all(
  programmes.map(async (programme) => ({
    programme,
    ...(await getEventsForProgramme(programme.id)),
  })),
);

/*
 * The meta description says what the three days are and when the next ones run,
 * and derives the dates rather than stating them.
 *
 * This is the hub that lists every programme, and its description did neither. It
 * read "repeating, in-person, hands-on formats for building with agentic AI",
 * which names no date and describes one line of the three: the Second Brain
 * Bootcamp is not agentic-workflow building, and it is on this page. That is
 * backlog 14's fault class on a seventh surface. The dates belong here for the
 * reason they were added to /events/ - the description is the field an answer
 * engine quotes most readily, and the next cohort's date is already published in
 * the header and footer of every page, so nothing new is asserted. The 29 Oct
 * probe is the evidence: an engine asked for a one-day hands-on AI bootcamp in
 * Oxford in November 2026 answered off a third party's July listing of ours and
 * concluded there was none.
 *
 * `formatsLine` is the one hand-written part, so it is guarded by the programme
 * count: a fourth line falls back to the generic sentence rather than silently
 * describing three of four. The dates are capped at the next two and dropped one
 * at a time if the pair would pass the 160 characters a description gets.
 */
const nextDates = rows
  .flatMap(({ upcoming }) => upcoming)
  .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime())
  .slice(0, 2)
  .map((event) => formatShortDate(event.data.startDate));

const formatsLine =
  programmes.length === 3
    ? 'Three one-day bootcamps in Oxford, hands-on and in person: build an agentic workflow, a second brain, or ship software.'
    : `Every one-day bootcamp ${config.brand.name} runs in Oxford, hands-on and in person, with what each day covers.`;

let description = formatsLine;
for (let count = nextDates.length; count > 0; count -= 1) {
  const dates = nextDates.slice(0, count);
  const candidate = `${formatsLine} Next cohort${dates.length > 1 ? 's' : ''}: ${dates.join(', ')}.`;
  if (candidate.length <= 160) {
    description = candidate;
    break;
  }
}
---

<Base
  pageTitle="Bootcamps"
  description={description}
  path={paths.programmes()}
  ogImage={ogPathFor(paths.programmes())}
  schemaNodes={[
    collectionPageSchema(
      'Bootcamps',
      paths.programmes(),
      programmes.map((p) => ({ name: p.data.name, path: paths.programme(p.data.slug) })),
    ),
  ]}
  breadcrumbs={[{ name: 'Bootcamps', path: paths.programmes() }]}
>
  <Hero
    eyebrow={config.brand.name}
    title="The programmes"
    subline="Each programme is a repeating format. Cohorts run several times a year, always in person, always in Oxford."
  />

  <section class="band band--cream" aria-labelledby="all">
    <div class="wrap">
      <h2 id="all" class="visually-hidden">All programmes</h2>
      <div class="rows">
        {
          rows.map(({ programme, upcoming, past }, i) => (
            <a href={paths.programme(programme.data.slug)} class="card row" data-reveal data-reveal-delay={i * 80}>
              <div>
                <span class="eyebrow">{`0${i + 1}`}</span>
                <h3>{programme.data.name}</h3>
                <p>{programme.data.shortPitch}</p>
                {/* The date, not a count. This is the page where someone picks a
                    programme, and "can I make it?" is half of that decision - every
                    other listing on the site (events index, footer, the programme
                    page itself) names the day, so a bare "1 upcoming" sent them a
                    click further for the one fact they came for. */}
                <p class="row__counts">
                  {upcoming.length === 0 && 'Next dates being confirmed'}
                  {upcoming.length === 1 && `Next cohort ${formatShortDate(upcoming[0].data.startDate)}`}
                  {upcoming.length > 1 &&
                    `${upcoming.length} upcoming, next ${formatShortDate(upcoming[0].data.startDate)}`}
                  {past.length > 0 && ` · ${past.length} already run`}
                </p>
              </div>
              <span class="row__arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .rows {
    display: grid;
    gap: 1rem;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .row h3 {
    margin-block: 0.2rem 0.65rem;
    font-size: var(--step-xl);
  }

  .row p {
    max-width: 54ch;
    font-size: var(--step-sm);
    color: var(--muted-on-cream);
  }

  .row__counts {
    margin-block-start: 0.8rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-size: var(--step-xs);
    color: var(--rust);
  }

  .row__arrow {
    font-size: 1.6rem;
    color: var(--burnt);
    flex: none;
    transition: transform 220ms var(--ease);
  }

  .row:hover .row__arrow {
    transform: translateX(5px);
  }
</style>

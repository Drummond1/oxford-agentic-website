---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import EventCard from '../../components/EventCard.astro';
import Faq from '../../components/Faq.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import config from '../../../site.config';
import {
  createRhythm,
  formatDate,
  getEventsForProgramme,
  getProgrammes,
  getTestimonials,
  isoDuration,
  paths,
  showSection,
} from '../../lib/site';
import { faqSchema } from '../../lib/schema';
import { ogPathFor } from '../../lib/og';

/**
 * The evergreen page. This one targets the standing keyword ("AI bootcamp
 * Oxford"); the dated event pages target dated intent.
 */
export async function getStaticPaths() {
  const programmes = await getProgrammes();
  return programmes.map((programme) => ({ params: { slug: programme.data.slug }, props: { programme } }));
}

const { programme } = Astro.props;
const data = programme.data;
const { Content } = await render(programme);

const { upcoming, past } = await getEventsForProgramme(programme.id);
const testimonials = await getTestimonials(programme.id);

const path = paths.programme(data.slug);

/*
 * Guides deliberately do NOT surface here (Drummond, 4 Aug): they are an SEO
 * and GEO play, reachable from the footer and their own index, and the
 * programme page's one job is the booking path. The guides still link TO this
 * page - the reverse edge crawlers follow - so the section loses no equity;
 * it just stops competing with "book" for the reader's next click.
 */
const showQuotes = showSection('testimonials', { hidden: data.hideSections, hasContent: testimonials.length > 0 });
const showFaq = showSection('faq', { hidden: data.hideSections, hasContent: data.faqs.length > 0 });

/*
 * A programme between cohorts has nothing to book, so the "Runs" band is the one
 * place on the page with no next step. Same answer LumaEmbed already gives an
 * event whose Luma page does not exist yet: offer the notify route instead of a
 * dead sentence. The footer carries the same form, but below the fold and on
 * every page, so it reads as site furniture rather than an answer to the line
 * directly above it.
 *
 * Reachable for the first time on 21 October 2026, when the Second Brain
 * Bootcamp's only cohort runs and that programme has no further date set.
 */
const showNotify = upcoming.length === 0 && showSection('newsletter');

/*
 * Google's course rich result reads the dates, workload and mode off each
 * instance. Built here rather than inline so the property can be omitted
 * entirely when a programme has no scheduled run: `hasCourseInstance: []`
 * claims the course has instances and then supplies none, which is malformed,
 * and the node is still a valid Course without it.
 */
const courseInstances = upcoming.map((event) => ({
  '@type': 'CourseInstance',
  name: event.data.title,
  url: `${config.brand.domain}${paths.event(event.data.slug)}`,
  courseMode: 'onsite',
  // Computed from the published start and end times, never asserted.
  courseWorkload: isoDuration(event.data.startDate, event.data.endDate),
  startDate: event.data.startDate.toISOString(),
  endDate: event.data.endDate.toISOString(),
  location: {
    '@type': 'Place',
    name: event.data.venue.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: event.data.venue.city,
      addressCountry: config.brand.country,
    },
  },
}));

const rhythm = createRhythm('cream');
const bands = {
  capsule: rhythm.next(),
  detail: rhythm.next(),
  runs: rhythm.next(),
  quotes: showQuotes ? rhythm.next() : null,
  faq: showFaq ? rhythm.next() : null,
};
---

<Base
  pageTitle={data.name}
  {/* "in Oxford" dropped from the suffix: both programme names already contain
      Oxford, and the repetition took the Second Brain title to 64 characters,
      past what a search result shows. The city is still in the title, once. */}
  titleOverride={`${data.name} | One-day AI bootcamp`}
  description={data.shortPitch}
  path={path}
  ogImage={ogPathFor(path)}
  schemaNodes={[
    {
      '@type': 'Course',
      '@id': `${config.brand.domain}${path}#course`,
      name: data.name,
      description: data.capsule,
      url: `${config.brand.domain}${path}`,
      provider: { '@id': `${config.brand.domain}/#organization` },
      inLanguage: 'en-GB',
      teaches: data.outcomes,
      courseMode: 'onsite',
      ...(courseInstances.length > 0 ? { hasCourseInstance: courseInstances } : {}),
    },
    showFaq ? faqSchema(data.faqs) : null,
  ]}
  breadcrumbs={[
    { name: 'Bootcamps', path: paths.programmes() },
    { name: data.name, path },
  ]}
>
  <Hero eyebrow={config.brand.name} title={data.name} subline={data.shortPitch} />

  {/* Answer capsule - front-loaded, self-contained, quotable (PRD §13). */}
  <section class:list={['band', `band--${bands.capsule}`]} aria-labelledby="what">
    <div class="wrap">
      <div class="card capsule-card" data-reveal>
        <h2 id="what" class="visually-hidden">What it is</h2>
        <p class="capsule">{data.capsule}</p>
        <p class="updated">
          Last updated {formatDate(data.updatedDate, { weekday: undefined })}
        </p>
      </div>

      {
        data.outcomes.length > 0 && (
          <div class="outcomes" data-reveal>
            <h3 class="outcomes__title">What you leave with</h3>
            <ul class="squares">
              {data.outcomes.map((outcome) => (
                <li>{outcome}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class:list={['band', `band--${bands.detail}`]} aria-labelledby="format">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <hr class="dash" />
        <h2 id="format">The format</h2>
      </div>

      <div class="detail" data-reveal>
        <div class="prose body-copy">
          <Content />
        </div>

        {
          data.whoFor.length > 0 && (
            <aside class="card who">
              <span class="eyebrow">Who it is for</span>
              <ul class="squares">
                {data.whoFor.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>
    </div>
  </section>

  <section class:list={['band', `band--${bands.runs}`]} aria-labelledby="runs">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <hr class="dash" />
        <h2 id="runs">{upcoming.length > 0 ? 'Upcoming runs' : 'Runs'}</h2>
      </div>

      {
        upcoming.length > 0 ? (
          <div class="grid grid--3">
            {upcoming.map((event, i) => (
              <div data-reveal data-reveal-delay={i * 80}>
                <EventCard event={event} programme={programme} />
              </div>
            ))}
          </div>
        ) : (
          <Fragment>
            <p class="empty">Dates for the next cohort are being confirmed.</p>
            {showNotify && (
              <div class="empty-notify">
                <NewsletterForm label="Tell me when the next dates are set" />
              </div>
            )}
          </Fragment>
        )
      }

      {
        past.length > 0 && (
          <div class="past">
            <h3 class="past__title">Previous cohorts</h3>
            <div class="grid grid--3">
              {past.map((event, i) => (
                <div data-reveal data-reveal-delay={i * 80}>
                  <EventCard event={event} programme={programme} />
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {
    showQuotes && (
      <section class:list={['band', `band--${bands.quotes}`]} aria-labelledby="quotes">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <hr class="dash" />
            <h2 id="quotes">From the room</h2>
          </div>
          <div class="grid grid--2">
            {testimonials.slice(0, 4).map((t, i) => (
              <blockquote class="card quote" data-reveal data-reveal-delay={i * 80}>
                <p>“{t.data.quote}”</p>
                <footer>
                  <cite>
                    {t.data.name} - {t.data.role}
                    {t.data.company && `, ${t.data.company}`}
                  </cite>
                </footer>
              </blockquote>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    showFaq && (
      <section class:list={['band', `band--${bands.faq}`]} aria-labelledby="programme-faq">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <hr class="dash" />
            <h2 id="programme-faq">Questions</h2>
          </div>
          <div data-reveal>
            <Faq faqs={data.faqs} />
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .capsule-card {
    max-width: 62rem;
  }

  .capsule {
    font-family: var(--font-title);
    font-size: var(--step-xl);
    line-height: 1.32;
    max-width: 52ch;
  }

  .updated {
    margin-block-start: 1.5rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--step-xs);
    color: var(--rust);
  }

  :global(.band--dark) .updated {
    color: var(--gold);
  }

  .outcomes {
    margin-block-start: 2.5rem;
    max-width: 62rem;
  }

  .outcomes__title {
    font-size: var(--step-lg);
    margin-block-end: 0.4rem;
  }

  .detail {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
    grid-template-columns: minmax(0, 1.6fr) minmax(min(100%, 17rem), 1fr);
    align-items: start;
  }

  @media (max-width: 52rem) {
    .detail {
      grid-template-columns: 1fr;
    }
  }

  .body-copy :global(p + p) {
    margin-block-start: 1.15rem;
  }

  :global(.band--dark) .body-copy {
    color: var(--muted-on-dark);
  }

  :global(.band--cream) .body-copy {
    color: var(--muted-on-cream);
  }

  .who .eyebrow {
    margin-block-end: 0.75rem;
  }

  .past {
    margin-block-start: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .past__title {
    font-size: var(--step-lg);
    margin-block-end: 1.25rem;
  }

  .empty {
    max-width: var(--measure);
    font-size: var(--step-lg);
  }

  .empty-notify {
    margin-block-start: 1.5rem;
  }

  .quote p {
    font-family: var(--font-title);
    font-size: var(--step-lg);
    line-height: 1.4;
  }

  .quote cite {
    display: block;
    margin-block-start: 1.2rem;
    font-family: var(--font-label);
    font-style: normal;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--step-xs);
  }
</style>

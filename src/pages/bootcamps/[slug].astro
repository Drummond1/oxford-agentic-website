---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import EventCard from '../../components/EventCard.astro';
import Faq from '../../components/Faq.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import config from '../../../site.config';
import {
  createRhythm,
  formatDate,
  formatShortDate,
  getEventsForProgramme,
  getProgrammes,
  getTestimonials,
  interestPath,
  paths,
  showSection,
} from '../../lib/site';
import { courseSchema, faqSchema } from '../../lib/schema';
import { ogPathFor } from '../../lib/og';

/**
 * The evergreen page. This one targets the standing keyword ("AI bootcamp
 * Oxford"); the dated event pages target dated intent.
 */
export async function getStaticPaths() {
  const programmes = await getProgrammes();
  return programmes.map((programme) => ({ params: { slug: programme.data.slug }, props: { programme } }));
}

const { programme } = Astro.props;
const data = programme.data;
const { Content } = await render(programme);

const { upcoming, past } = await getEventsForProgramme(programme.id);
const testimonials = await getTestimonials(programme.id);

const path = paths.programme(data.slug);

/*
 * Guides deliberately do NOT surface here (Drummond, 4 Aug): they are an SEO
 * and GEO play, reachable from the footer and their own index, and the
 * programme page's one job is the booking path. The guides still link TO this
 * page - the reverse edge crawlers follow - so the section loses no equity;
 * it just stops competing with "book" for the reader's next click.
 */
const showQuotes = showSection('testimonials', { hidden: data.hideSections, hasContent: testimonials.length > 0 });
const showFaq = showSection('faq', { hidden: data.hideSections, hasContent: data.faqs.length > 0 });

/*
 * A programme between cohorts has nothing to book, so the "Runs" band is the one
 * place on the page with no next step. Same answer LumaEmbed already gives an
 * event whose Luma page does not exist yet: offer the notify route instead of a
 * dead sentence. The footer carries the same form, but below the fold and on
 * every page, so it reads as site furniture rather than an answer to the line
 * directly above it.
 *
 * Reachable for the first time on 21 October 2026, when the Second Brain
 * Bootcamp's only cohort runs and that programme has no further date set.
 *
 * Unless the programme has a register-interest page, which does the same job
 * properly: then that button is the band's one next step and the form below it
 * would be the same ask a second time, by the weaker route.
 */
const interest = interestPath(programme.id);
const showNotify = upcoming.length === 0 && !interest && showSection('newsletter');

/*
 * `shortPitch` is doing two jobs, the way `summary` was on the event pages until
 * 29 October. It is the hero subline and the line under the heading on every
 * programme card on `/bootcamps/`, where the next cohort's date is printed
 * directly above it - and it is this page's meta description, where there is no
 * line above it. So the flagship programme page, which Search Console had at 192
 * impressions and position 9.5 on 11 October, described a repeating one-day
 * bootcamp in a search result and never said when the next one runs.
 *
 * The page composes its own instead, and `shortPitch` is left alone so the card
 * and `llms.txt` keep the string written for them. The date comes from the same
 * `upcoming[0]` the "Runs" band below renders a card for, so it is derived and
 * cannot go stale: between cohorts the clause is simply absent, which is what
 * `/bootcamps/second-brain-bootcamp/` reads like today. The month is shortened if
 * the full form would pass 160 characters, and the pitch stands alone if that is
 * still not enough - which is where the Coding Bootcamp lands, its own pitch
 * being 141 characters.
 */
const metaDescription = (() => {
  const next = upcoming[0];
  if (!next) return data.shortPitch;
  const long = `Next cohort ${formatDate(next.data.startDate, { weekday: undefined })}. ${data.shortPitch}`;
  if (long.length <= 160) return long;
  const short = `Next cohort ${formatShortDate(next.data.startDate)}. ${data.shortPitch}`;
  return short.length <= 160 ? short : data.shortPitch;
})();

const rhythm = createRhythm('cream');
const bands = {
  capsule: rhythm.next(),
  detail: rhythm.next(),
  runs: rhythm.next(),
  quotes: showQuotes ? rhythm.next() : null,
  faq: showFaq ? rhythm.next() : null,
};
---

<Base
  pageTitle={data.name}
  {/* "in Oxford" dropped from the suffix: both programme names already contain
      Oxford, and the repetition took the Second Brain title to 64 characters,
      past what a search result shows. The city is still in the title, once. */}
  titleOverride={`${data.name} | One-day AI bootcamp`}
  description={metaDescription}
  path={path}
  ogImage={ogPathFor(path)}
  {/* The Course node is built by the shared helper, because the homepage
      publishes it too under this same `@id`. */}
  schemaNodes={[courseSchema(programme, upcoming), showFaq ? faqSchema(data.faqs, path) : null]}
  breadcrumbs={[
    { name: 'Bootcamps', path: paths.programmes() },
    { name: data.name, path },
  ]}
>
  <Hero eyebrow={config.brand.name} title={data.name} subline={data.shortPitch} />

  {/* Answer capsule - front-loaded, self-contained, quotable (PRD §13). */}
  <section class:list={['band', `band--${bands.capsule}`]} aria-labelledby="what">
    <div class="wrap">
      <div class="card capsule-card" data-reveal>
        <h2 id="what" class="visually-hidden">What it is</h2>
        <p class="capsule">{data.capsule}</p>
        <p class="updated">
          Last updated {formatDate(data.updatedDate, { weekday: undefined })}
        </p>
      </div>

      {
        data.outcomes.length > 0 && (
          <div class="outcomes" data-reveal>
            <h3 class="outcomes__title">What you leave with</h3>
            <ul class="squares">
              {data.outcomes.map((outcome) => (
                <li>{outcome}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class:list={['band', `band--${bands.detail}`]} aria-labelledby="format">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <hr class="dash" />
        <h2 id="format">The format</h2>
      </div>

      <div class="detail" data-reveal>
        <div class="prose body-copy">
          <Content />
        </div>

        {
          data.whoFor.length > 0 && (
            <aside class="card who">
              {/* The label is the card's heading, not a kicker above one, so it
                  is marked as the heading it already reads as. It sits under
                  "The format" beside the h3 "What you leave with", and keeps the
                  eyebrow's look. */}
              <h3 class="eyebrow">Who it is for</h3>
              <ul class="squares">
                {data.whoFor.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>
    </div>
  </section>

  <section class:list={['band', `band--${bands.runs}`]} aria-labelledby="runs">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <hr class="dash" />
        <h2 id="runs">{upcoming.length > 0 ? 'Upcoming runs' : 'Runs'}</h2>
      </div>

      {
        upcoming.length > 0 ? (
          <div class="grid grid--3">
            {upcoming.map((event, i) => (
              <div data-reveal data-reveal-delay={i * 80}>
                <EventCard event={event} programme={programme} />
              </div>
            ))}
          </div>
        ) : (
          <Fragment>
            <p class="empty">Dates for the next cohort are being confirmed.</p>
            {interest && (
              <p class="btn-row">
                <a href={interest} class="btn btn--primary" data-analytics-event="sb_interest_link_click">
                  Register your interest <span aria-hidden="true">→</span>
                </a>
              </p>
            )}
            {showNotify && (
              <div class="empty-notify">
                <NewsletterForm label="Tell me when the next dates are set" />
              </div>
            )}
          </Fragment>
        )
      }

      {
        past.length > 0 && (
          <div class="past">
            <h3 class="past__title">Previous cohorts</h3>
            <div class="grid grid--3">
              {past.map((event, i) => (
                <div data-reveal data-reveal-delay={i * 80}>
                  <EventCard event={event} programme={programme} />
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {
    showQuotes && (
      <section class:list={['band', `band--${bands.quotes}`]} aria-labelledby="quotes">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <hr class="dash" />
            <h2 id="quotes">From the room</h2>
          </div>
          <div class="grid grid--2">
            {testimonials.slice(0, 4).map((t, i) => (
              <blockquote class="card quote" data-reveal data-reveal-delay={i * 80}>
                <p>“{t.data.quote}”</p>
                <footer>
                  <cite>
                    {t.data.name} - {t.data.role}
                    {t.data.company && `, ${t.data.company}`}
                  </cite>
                </footer>
              </blockquote>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    showFaq && (
      <section class:list={['band', `band--${bands.faq}`]} aria-labelledby="programme-faq">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <hr class="dash" />
            <h2 id="programme-faq">Questions</h2>
          </div>
          <div data-reveal>
            <Faq faqs={data.faqs} />
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .capsule-card {
    max-width: 62rem;
  }

  .capsule {
    font-family: var(--font-title);
    font-size: var(--step-xl);
    line-height: 1.32;
    max-width: 52ch;
  }

  .updated {
    margin-block-start: 1.5rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--step-xs);
    color: var(--rust);
  }

  :global(.band--dark) .updated {
    color: var(--gold);
  }

  .outcomes {
    margin-block-start: 2.5rem;
    max-width: 62rem;
  }

  .outcomes__title {
    font-size: var(--step-lg);
    margin-block-end: 0.4rem;
  }

  .detail {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
    grid-template-columns: minmax(0, 1.6fr) minmax(min(100%, 17rem), 1fr);
    align-items: start;
  }

  @media (max-width: 52rem) {
    .detail {
      grid-template-columns: 1fr;
    }
  }

  .body-copy :global(p + p) {
    margin-block-start: 1.15rem;
  }

  :global(.band--dark) .body-copy {
    color: var(--muted-on-dark);
  }

  :global(.band--cream) .body-copy {
    color: var(--muted-on-cream);
  }

  .who .eyebrow {
    margin-block-end: 0.75rem;
  }

  .past {
    margin-block-start: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .past__title {
    font-size: var(--step-lg);
    margin-block-end: 1.25rem;
  }

  .empty {
    max-width: var(--measure);
    font-size: var(--step-lg);
  }

  .empty-notify {
    margin-block-start: 1.5rem;
  }

  .quote p {
    font-family: var(--font-title);
    font-size: var(--step-lg);
    line-height: 1.4;
  }

  .quote cite {
    display: block;
    margin-block-start: 1.2rem;
    font-family: var(--font-label);
    font-style: normal;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--step-xs);
  }
</style>

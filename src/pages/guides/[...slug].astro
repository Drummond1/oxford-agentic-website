---
import { getCollection, getEntry, render } from 'astro:content';
import { GUIDE_CATEGORIES } from '../../content.config';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import config from '../../../site.config';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { formatDate, getProgrammes, paths, showSection } from '../../lib/site';
import { articleSchema } from '../../lib/schema';
import { absoluteUrl } from '../../lib/site';
import { ogPathFor } from '../../lib/og';

/** Guides — a flagged section (PRD §11). */
export async function getStaticPaths() {
  if (!config.features.guides) return [];

  const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
  );

  return [
    { params: { slug: undefined }, props: { guides } },
    ...guides.map((guide) => ({ params: { slug: guide.data.slug }, props: { guide, guides } })),
  ];
}

const { guide, guides } = Astro.props;

const Body = guide ? (await render(guide)).Content : null;
const author = guide ? await getEntry(guide.data.author) : null;
const programmes = await getProgrammes();
const related = guide
  ? programmes.filter((p) => guide.data.relatedProgrammes.some((ref) => ref.id === p.id))
  : [];

/*
 * Sibling guides. Listing every other guide kept the section fully connected
 * when there were three of them; at twelve it is a wall of undifferentiated
 * links that helps nobody choose. Same-category guides come first, then the
 * newest from elsewhere to fill, capped at four — with a link to the full
 * index underneath, so nothing becomes unreachable.
 */
const siblings = guide ? guides.filter((g) => g.data.slug !== guide.data.slug) : [];
const sameCategory = siblings.filter((g) => g.data.category === guide?.data.category);
const otherGuides = [...sameCategory, ...siblings.filter((g) => !sameCategory.includes(g))].slice(0, 4);

// Index only: guides grouped into the reader's journey, in category order.
const grouped = GUIDE_CATEGORIES.map((category) => ({
  ...category,
  entries: guides.filter((g) => g.data.category === category.id),
})).filter((group) => group.entries.length > 0);

const showCapture = showSection('newsletter');
---

{
  guide ? (
    <Base
      pageTitle={guide.data.title}
      description={guide.data.description}
      path={paths.guide(guide.data.slug)}
      ogImage={ogPathFor(paths.guide(guide.data.slug))}
      schemaNodes={[
        articleSchema({
          title: guide.data.title,
          slug: guide.data.slug,
          description: guide.data.description,
          publishDate: guide.data.publishDate,
          updatedDate: guide.data.updatedDate,
          authorName: author?.data.name ?? config.brand.name,
          authorSlug: author?.data.slug ?? 'team',
          ogImage: absoluteUrl(ogPathFor(paths.guide(guide.data.slug))),
          about: related.map((p) => ({ name: p.data.name, path: paths.programme(p.data.slug) })),
        }),
      ]}
      breadcrumbs={[
        { name: 'Guides', path: paths.guides() },
        { name: guide.data.title, path: paths.guide(guide.data.slug) },
      ]}
      article={{
        publishedTime: guide.data.publishDate,
        modifiedTime: guide.data.updatedDate,
        author: author?.data.name ?? config.brand.name,
      }}
    >
      <Hero eyebrow="Guide" title={guide.data.title} />

      <section class="band band--cream">
        <div class="wrap wrap--narrow">
          {/* Answer capsule - front-loaded and quotable (PRD §13). */}
          <p class="capsule" data-reveal>
            {guide.data.capsule}
          </p>

          <p class="byline">
            {author && <>By {author.data.name} · </>}
            Updated {formatDate(guide.data.updatedDate, { weekday: undefined })}
          </p>

          <article class="prose article" data-anchor-headings>
            <Body />
          </article>

          {/* Every guide links to at least one programme - PRD §12. */}
          {related.length > 0 && (
            <aside class="card related">
              <span class="eyebrow">Where this gets practical</span>
              <ul class="squares">
                {related.map((programme) => (
                  <li>
                    <a href={paths.programme(programme.data.slug)}>{programme.data.name}</a> - {programme.data.shortPitch}
                  </li>
                ))}
              </ul>
            </aside>
          )}

          {/* Sibling guides, so readers (and crawlers) never dead-end here. */}
          {otherGuides.length > 0 && (
            <nav class="more" aria-labelledby="more-guides">
              <h2 id="more-guides" class="more__title">More guides</h2>
              <ul class="more__list">
                {otherGuides.map((g) => (
                  <li>
                    <a href={paths.guide(g.data.slug)}>{g.data.title}</a>
                  </li>
                ))}
              </ul>
              <p class="more__all">
                <a href={paths.guides()}>All guides</a>
              </p>
            </nav>
          )}

          {/* Lead capture - guides earn search/AI traffic; this quietly converts a
              reader into a subscriber at the moment they are most interested. */}
          {showCapture && (
            <aside class="card capture" data-reveal>
              <NewsletterForm compact label="Hear about the next cohort first" />
            </aside>
          )}
        </div>
      </section>
    </Base>
  ) : (
    <Base
      pageTitle="Guides"
      description={`Practical writing on agentic AI for business leaders, from ${config.brand.name} in Oxford.`}
      path={paths.guides()}
      ogImage={ogPathFor(paths.guides())}
      schemaNodes={[
        {
          '@type': 'CollectionPage',
          name: 'Guides',
          url: absoluteUrl(paths.guides()),
          isPartOf: { '@id': `${config.brand.domain}/#website` },
          mainEntity: {
            '@type': 'ItemList',
            itemListElement: guides.map((entry, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name: entry.data.title,
              url: absoluteUrl(paths.guide(entry.data.slug)),
            })),
          },
        },
      ]}
      breadcrumbs={[{ name: 'Guides', path: paths.guides() }]}
    >
      <Hero
        eyebrow={config.brand.name}
        title="Writing on agentic AI"
        subline="Short, practical pieces for people who intend to build something rather than form a view."
      />

      {
        /* Grouped by where the reader is, not by publication date: someone
           landing here wants the one guide for their situation, and a flat
           reverse-chronological grid makes that a reading exercise. */
      }
      <section class="band band--cream" aria-labelledby="all">
        <div class="wrap">
          <h2 id="all" class="visually-hidden">
            All guides
          </h2>

          {grouped.length > 0 ? (
            grouped.map((group) => (
              <div class="guide-group">
                <div class="section-head" data-reveal>
                  <hr class="dash" />
                  <h3 id={group.id}>{group.label}</h3>
                  <p>{group.blurb}</p>
                </div>

                <div class="grid grid--3">
                  {group.entries.map((entry, i) => (
                    <a href={paths.guide(entry.data.slug)} class="card guide-card" data-reveal data-reveal-delay={i * 80}>
                      <span class="eyebrow">{formatDate(entry.data.updatedDate, { weekday: undefined, day: undefined })}</span>
                      <h4>{entry.data.title}</h4>
                      <p>{entry.data.description}</p>
                      <span class="guide-card__cta">
                        Read <span aria-hidden="true">→</span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            ))
          ) : (
            <p class="empty">The first guides are being written.</p>
          )}
        </div>
      </section>
    </Base>
  )
}

<script>
  // Heading anchors. The build already gives every article heading an id, so
  // deep links work without this — the script only adds a visible, clickable
  // handle on hover, and copies the URL when used.
  const article = document.querySelector('[data-anchor-headings]');

  article?.querySelectorAll<HTMLHeadingElement>('h2[id], h3[id]').forEach((heading) => {
    const link = document.createElement('a');
    link.className = 'heading-anchor';
    link.href = `#${heading.id}`;
    link.textContent = '#';
    link.setAttribute('aria-label', `Link to section: ${heading.textContent?.trim() ?? ''}`);

    link.addEventListener('click', (event) => {
      const url = `${location.origin}${location.pathname}#${heading.id}`;
      navigator.clipboard?.writeText(url).then(
        () => {
          event.preventDefault();
          history.replaceState(null, '', `#${heading.id}`);
          link.dataset.copied = 'true';
          window.setTimeout(() => delete link.dataset.copied, 1400);
        },
        () => {
          /* Clipboard unavailable — the link still navigates normally. */
        },
      );
    });

    heading.append(link);
  });
</script>

<style>
  .capsule {
    font-family: var(--font-title);
    font-size: var(--step-xl);
    line-height: 1.32;
    max-width: 50ch;
  }

  .byline {
    margin-block-start: 1.5rem;
    padding-block-end: 1.75rem;
    border-block-end: 1px solid rgba(5, 24, 23, 0.14);
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--step-xs);
    color: var(--rust);
  }

  .article {
    margin-block-start: 2rem;
    color: var(--muted-on-cream);
  }

  .article :global(p + p),
  .article :global(ul),
  .article :global(h2),
  .article :global(h3) {
    margin-block-start: 1.3rem;
  }

  .article :global(h2) {
    color: var(--ink-dark);
    margin-block-start: 2.25rem;
  }

  .article :global(li) {
    margin-block-start: 0.5rem;
  }

  .related {
    margin-block-start: 2.75rem;
  }

  .related .eyebrow {
    margin-block-end: 0.8rem;
  }

  .capture {
    margin-block-start: 2.5rem;
  }

  .more {
    margin-block-start: 2.5rem;
    padding-block-start: 1.75rem;
    border-block-start: 1px solid rgba(5, 24, 23, 0.14);
  }

  .more__title {
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: var(--step-xs);
    color: var(--rust);
  }

  .more__list {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
  }

  .more__list li + li {
    margin-block-start: 0.55rem;
  }

  .more__list a {
    font-family: var(--font-title);
    font-size: var(--step-lg);
    color: var(--ink-dark);
  }

  .more__all {
    margin-block-start: 1.1rem;
  }

  .more__all a {
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: var(--step-xs);
  }

  /* Groups need more air between them than the cards inside one, or the
     headings stop reading as dividers. */
  .guide-group + .guide-group {
    margin-block-start: clamp(2.75rem, 2rem + 3vw, 4.5rem);
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* h4 on the index (nested under a group h3), h3 nowhere else — same look. */
  .guide-card :is(h3, h4) {
    font-family: var(--font-title);
    font-size: var(--step-lg);
    margin-block-end: 0.75rem;
  }

  .guide-card p {
    flex: 1;
    font-size: var(--step-sm);
    color: var(--muted-on-cream);
  }

  .guide-card__cta {
    display: inline-flex;
    gap: 0.4rem;
    margin-block-start: 1.5rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: var(--step-xs);
    color: var(--burnt);
  }

  .empty {
    max-width: var(--measure);
    font-size: var(--step-lg);
  }
</style>

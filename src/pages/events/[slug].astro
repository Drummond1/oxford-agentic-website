---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import LumaEmbed from '../../components/LumaEmbed.astro';
import config from '../../../site.config';
import {
  createRhythm,
  effectiveStatus,
  formatDate,
  formatMonthYear,
  formatTimeRange,
  getEvents,
  getPhotos,
  getPredecessorEvent,
  getProgrammes,
  getSuccessorEvent,
  getTestimonials,
  lumaUrlWithUtm,
  paths,
  showSection,
  venueLine,
} from '../../lib/site';
import { eventSchema, faqSchema } from '../../lib/schema';
import { ogPathFor } from '../../lib/og';
import { absoluteUrl } from '../../lib/site';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event) => ({ params: { slug: event.data.slug }, props: { event } }));
}

const { event } = Astro.props;
const data = event.data;
const status = effectiveStatus(event);
const isPast = status === 'past' || status === 'cancelled';

const programmes = await getProgrammes();
const programme = programmes.find((p) => p.id === data.programme.id)!;
const successor = isPast ? await getSuccessorEvent(event) : undefined;
const testimonials = await getTestimonials(programme.id);
const photos = await getPhotos('event', event.id);

/*
 * Proof that the day is real — the evidence band below.
 *
 * An upcoming event page asks for money for something that has never visibly
 * happened: photographs, attendee counts and outcome stats all belong to the
 * run that is already over, and until now they rendered only on that run's own
 * page. Nobody deciding whether to book September opens the July page. So the
 * page taking the payment carried no evidence, while the evidence sat one
 * click away on a page with nothing to sell.
 *
 * Everything here is already published elsewhere on this site — the same
 * consent-cleared photos, the predecessor's own `outcomes`. Nothing new is
 * claimed and no consent flag is touched: getPhotos filters on consent before
 * anything else, so a held-back photo cannot reach this band either.
 */
const predecessor = isPast ? undefined : await getPredecessorEvent(event);
const predecessorPhotos = predecessor ? await getPhotos('event', predecessor.id) : [];
const showProof = Boolean(
  predecessor && (predecessor.data.outcomes.length > 0 || predecessorPhotos.length > 0),
);

// Consent-cleared photos double as schema images — Google's event rich results
// prefer real photography over a generated card. Each frame carries its alt
// text as the caption, so a cited image explains what it shows.
const schemaPhotos = photos
  .filter((photo) => Boolean(photo.data.file.src))
  .map((photo) => ({
    url: photo.data.file.src.startsWith('http') ? photo.data.file.src : `${config.brand.domain}${photo.data.file.src}`,
    caption: photo.data.alt,
  }));

const path = paths.event(data.slug);
const ogImage = ogPathFor(path);

/*
 * PRD §12 title pattern for events: {Event title} | {Month Year} | {Brand}.
 *
 * The brand suffix is dropped when keeping it would push the title past what a
 * search result shows. All three event titles were over — "The Oxford Agentic
 * Bootcamp - Cohort 2 | September 2026 | Oxford Agentic" is 73 characters and
 * says Oxford Agentic twice, and Cohort 2 is the page people book from, so it
 * was the worst place on the site to be truncated.
 *
 * The rule keys off length rather than off whether the title already contains
 * the brand: "The Oxford Second Brain Bootcamp" carries the city but not the
 * brand, so a contains-check left it at 75 while fixing the other two.
 */
const SERP_TITLE_LIMIT = 60;
const monthYear = formatMonthYear(data.startDate);
const titleWithBrand = `${data.title} | ${monthYear} | ${config.brand.name}`;
const title =
  titleWithBrand.length > SERP_TITLE_LIMIT ? `${data.title} | ${monthYear}` : titleWithBrand;

const eyebrow = [programme.data.name, data.edition ?? data.cohort].filter(Boolean).join(' - ');

/*
 * The hero promise. Falls back to the programme's shortPitch so an event
 * without its own line still says why the day is worth a day, rather than
 * showing a product name and a postcode and nothing else.
 *
 * Past events are excluded: a promise in the future tense over an event that
 * has already run reads as an error, and the past hero has its own line.
 */
const promise = isPast ? undefined : (data.promise ?? programme.data.shortPitch);

const showAgenda = showSection('agenda', { hidden: data.hideSections, hasContent: data.agenda.length > 0 });
const showBuild = showSection('whatYoullBuild', { hidden: data.hideSections, hasContent: data.whatYoullBuild.length > 0 });
const showQuotes = showSection('testimonials', { hidden: data.hideSections, hasContent: testimonials.length > 0 });
const showFaq = showSection('faq', { hidden: data.hideSections, hasContent: data.faqs.length > 0 });
const showPhotos = showSection('photos', { hidden: data.hideSections, hasContent: isPast && photos.length > 0 });

/*
 * Band order, reworked 17 Aug for conversion.
 *
 * The booking form used to sit third, under a key-facts card carrying a
 * capsule, a definition list, five "who it is for" lines and three "what you
 * will build" lines. Someone arriving from a paid ad had to read all of that
 * before they could see a form — on the page taking the payment. The hero
 * already states the promise, the date, the time and the venue, which is enough
 * to decide whether to look at the form, so the form now comes straight after
 * it and everything that supports the decision follows underneath.
 *
 * Proof and quotes moved up with it: evidence is worth most immediately after
 * the ask, and the testimonial band was previously sixth, below the agenda and
 * the photos, where nobody hesitating over a card field would ever reach it.
 *
 * `register` is pinned dark instead of taking its turn in the alternation.
 * LumaEmbed's fallback link, loading placeholder and iframe border are all
 * styled for a dark ground; letting the rhythm hand it a cream band would make
 * the one component on the conversion path illegible. Pinned, it keeps working
 * wherever it is moved to next.
 */
const rhythm = createRhythm('cream');
const bands = {
  register: 'dark' as const,
  proof: showProof ? rhythm.next() : null,
  quotes: showQuotes ? rhythm.next() : null,
  facts: rhythm.next(),
  agenda: showAgenda ? rhythm.next() : null,
  photos: showPhotos ? rhythm.next() : null,
  faq: showFaq ? rhythm.next() : null,
};

// The CTA has to tell the truth about what it does. An announced event whose
// Luma page does not exist yet offers a notify state, not a booking.
const registrationOpen = Boolean(data.lumaEventId);

/*
 * Every primary CTA goes straight to Luma (Drummond, 18 Aug), instead of jumping
 * down the page to the embed.
 *
 * They used to be in-page anchors labelled "Register below ↓" and "Register ↑" —
 * labels that describe a scroll rather than an outcome, and one of which sent
 * people backwards up the page. Luma's own page is the better place to land
 * anyway: it carries the guest count and host detail the iframe crops out, its
 * checkout is proven on mobile, and it cannot be blocked the way a third-party
 * embed can.
 *
 * The embed stays where it is for anyone who scrolls to it, so there are two
 * routes to the same checkout rather than one route and a detour.
 *
 * `lumaUrlWithUtm` is used rather than the bare URL so these clicks keep landing
 * on utm_source=oxfordagentic — the source that has already been credited with a
 * registration. Sending traffic off-site on an untagged link would silently
 * destroy the only working attribution this project has. The
 * `luma_outbound_click` analytics event is on each one for the same reason.
 */
const bookHref = data.lumaUrl ? lumaUrlWithUtm(data.lumaUrl, data.slug) : '#register';
const bookIsExternal = bookHref !== '#register';

// "Book" beats "Register": it is what the visitor is actually doing, it implies a
// held place rather than a form, and it does not share a word with the free
// newsletter sign-up further down the page.
const registerLabel = !registrationOpen
  ? 'Get notified'
  : status === 'soldout'
    ? 'Join the waitlist'
    : 'Book your place';

// The hand-rolled .ics data: URI that used to live here went with the "Add to
// calendar" button, along with the click-feedback script at the bottom of this
// file. Luma sends a calendar invite when someone books, which is the moment the
// invite is actually worth having.
---

<Base
  pageTitle={data.title}
  titleOverride={title}
  description={data.summary}
  path={path}
  ogImage={ogImage}
  schemaNodes={[eventSchema(event, programme, absoluteUrl(ogImage), schemaPhotos), showFaq ? faqSchema(data.faqs) : null]}
  breadcrumbs={[
    { name: 'Events', path: paths.events() },
    { name: data.title, path },
  ]}
  bodyClass={!isPast ? 'has-sticky-bar' : ''}
>
  {/* ---- Hero ---- */}
  <section class="band band--dark event-hero">
    <div class="wrap">
      <span class="eyebrow">{eyebrow}</span>
      <hr class="dash" />
      <h1>{data.title}</h1>

      {promise && <p class="event-hero__promise">{promise}</p>}

      <p class="event-hero__meta">
        <span>{formatDate(data.startDate)}</span>
        <span class="sq" aria-hidden="true"></span>
        <span>{formatTimeRange(data.startDate, data.endDate)}</span>
        <span class="sq" aria-hidden="true"></span>
        <span>{venueLine(data.venue)}</span>
      </p>

      {/* No past-event line here any more. It read "This event has already run."
          directly above a band headed "This event has run" once the booking band
          moved up to second position, which is the same sentence twice in a row.
          The band says it, and says what to do next. */}
      {/* "Add to calendar" was the second button here and is gone. Diarising an
          event you have not booked is not a step towards booking it, and it sat
          in the one place on the page where the only useful action is the
          primary one. Luma sends a calendar invite on booking anyway, so nothing
          is lost except a competing click. */}
      {
        !isPast && (
          <div class="btn-row">
            <a
              href={bookHref}
              class="btn btn--primary"
              rel={bookIsExternal ? 'noopener' : undefined}
              data-analytics-event={bookIsExternal ? 'luma_outbound_click' : undefined}
              data-analytics-slug={data.slug}
            >
              {registerLabel}
            </a>
          </div>
        )
      }
    </div>
  </section>

  {/* ---- Registration ----
       Second on the page, directly under the hero. See the band-order note in
       the frontmatter for why. */}
  <section class:list={['band', `band--${bands.register}`]} id="register" aria-labelledby="register-heading">
    <div class="wrap">
      {
        isPast ? (
          <div class="ran" data-reveal>
            <hr class="dash" />
            <h2 id="register-heading">This event has run</h2>
            <p class="ran__copy">
              {data.title} took place on {formatDate(data.startDate)} at {venueLine(data.venue)}.
              {successor
                ? ' The next cohort runs the same format - details below.'
                : ' Dates for the next cohort are being confirmed.'}
            </p>
            {successor ? (
              <div class="btn-row">
                <a
                  href={paths.event(successor.data.slug)}
                  class="btn btn--primary"
                  data-analytics-event="next_event_cta_click"
                  data-analytics-slug={successor.data.slug}
                >
                  {successor.data.cohort ?? 'The next cohort'} - {formatDate(successor.data.startDate, { weekday: undefined, month: 'long' })}
                </a>
                <a href={paths.events()} class="btn btn--ghost">
                  All events
                </a>
              </div>
            ) : (
              <div class="btn-row">
                <a href={paths.events()} class="btn btn--primary">
                  All events
                </a>
              </div>
            )}
          </div>
        ) : (
          <div data-reveal>
            <h2 id="register-heading" class="visually-hidden">
              Register
            </h2>
            <LumaEmbed event={event} />
            {data.assurances.length > 0 && (
              <ul class="assurances">
                {data.assurances.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </div>
  </section>

  {/* ---- Proof: the last run of this programme ----
       Sits directly under the booking form, because that is where the question
       it answers gets asked. Copy is the predecessor's own capsule, verbatim,
       and the stats are its own `outcomes` — this band reports, it never
       claims. */}
  {
    showProof && predecessor && (
      <section class:list={['band', `band--${bands.proof}`]} aria-labelledby="proof">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <hr class="dash" />
            <h2 id="proof">
              {predecessor.data.cohort ?? 'The last cohort'} ran on{' '}
              {formatDate(predecessor.data.startDate, { weekday: undefined })}
            </h2>
          </div>

          <p class="proof__copy" data-reveal>{predecessor.data.capsule}</p>

          {predecessor.data.outcomes.length > 0 && (
            <div class="stats" data-reveal>
              {predecessor.data.outcomes.map((outcome) => (
                <div class="stat">
                  <span class="stat__value">{outcome.stat}</span>
                  <span class="stat__label">{outcome.label}</span>
                </div>
              ))}
            </div>
          )}

          {predecessorPhotos.length > 0 && (
            <div class="grid grid--2 proof__photos">
              {predecessorPhotos.slice(0, 2).map((photo, i) => (
                <figure class="photo" data-reveal data-reveal-delay={i * 80}>
                  <Image
                    src={photo.data.file}
                    alt={photo.data.alt}
                    widths={[480, 800, 1200]}
                    sizes="(max-width: 48rem) 100vw, 22rem"
                    loading="lazy"
                  />
                </figure>
              ))}
            </div>
          )}

          <p class="proof__link" data-reveal>
            <a href={paths.event(predecessor.data.slug)}>
              How the day ran, in full →
            </a>
          </p>
        </div>
      </section>
    )
  }

  {/* ---- Testimonials ----
       Beside the proof band rather than sixth, below the agenda and the photos.
       An attendee's own words are evidence for the decision being made at the
       form above, and they were previously three screens past it. */}
  {
    showQuotes && (
      <section class:list={['band', `band--${bands.quotes}`]} aria-labelledby="quotes">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <hr class="dash" />
            <h2 id="quotes">From the room</h2>
          </div>
          <div class="grid grid--2">
            {testimonials.slice(0, 4).map((t, i) => (
              <blockquote class="card quote" data-reveal data-reveal-delay={i * 80}>
                <p>“{t.data.quote}”</p>
                <footer>
                  {/* Name, role and company only. The date used to render beside
                      the cohort and it caused more confusion than it settled: a
                      quote sent in August about a day in July showed as "Cohort
                      1, 14 August 2026" directly under a band headed "Cohort 1
                      ran on 21 July 2026", which reads as a contradiction rather
                      than as the date it was written. `date` is still required on
                      every quote and still orders this list — it just is not a
                      line of copy any more. */}
                  <cite>
                    {t.data.name} - {t.data.role}
                    {t.data.company && `, ${t.data.company}`}
                  </cite>
                  <span class="quote__when">{t.data.cohort}</span>
                </footer>
              </blockquote>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* ---- Key facts / answer capsule ----
       Plain HTML, no iframe and no JS. Crawlers cannot read the Luma embed, so
       every fact inside it also lives here (PRD §9.5, §13). Below the form since
       17 Aug: the hero already carries the promise, the date, the time and the
       venue, so this is the detail someone reads to confirm a decision rather
       than the copy they need in order to make one. */}
  <section class:list={['band', `band--${bands.facts}`]} aria-labelledby="facts">
    <div class="wrap">
      <div class="facts-card card" data-reveal>
        <h2 id="facts" class="visually-hidden">Key facts</h2>
        <p class="capsule">{data.capsule}</p>

        <dl class="facts">
          <div>
            <dt>Date</dt>
            <dd>{formatDate(data.startDate)}</dd>
          </div>
          <div>
            <dt>Time</dt>
            <dd>{formatTimeRange(data.startDate, data.endDate)}</dd>
          </div>
          <div>
            <dt>Venue</dt>
            <dd>
              {[data.venue.name, data.venue.street, data.venue.city, data.venue.postcode].filter(Boolean).join(', ')}
              {!data.venue.confirmed && <span class="facts__note">Room booking being finalised.</span>}
            </dd>
          </div>
          {
            data.capacity && (
              <div>
                <dt>Capacity</dt>
                <dd>Capped at {data.capacity}</dd>
              </div>
            )
          }
          {
            data.whoFor.length > 0 && (
              <div class="facts--wide">
                <dt>Who it is for</dt>
                <dd>
                  <ul class="squares">
                    {data.whoFor.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
          {
            showBuild && (
              <div class="facts--wide">
                <dt>What you will build</dt>
                <dd>
                  <ul class="squares">
                    {data.whatYoullBuild.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>

        <p class="facts__programme">
          Part of <a href={paths.programme(programme.data.slug)}>{programme.data.name}</a>.
        </p>
      </div>

      {
        data.outcomes.length > 0 && (
          <div class="stats" data-reveal>
            {data.outcomes.map((outcome) => (
              <div class="stat">
                <span class="stat__value">{outcome.stat}</span>
                <span class="stat__label">{outcome.label}</span>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {/* ---- Agenda ---- */}
  {
    showAgenda && (
      <section class:list={['band', `band--${bands.agenda}`]} aria-labelledby="agenda">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <hr class="dash" />
            <h2 id="agenda">{isPast ? 'How the day ran' : 'What happens on the day'}</h2>
          </div>

          <ol class="agenda">
            {data.agenda.map((item, i) => (
              <li class="agenda__row" data-reveal data-reveal-delay={Math.min(i, 6) * 40}>
                <span class="agenda__time">{item.time}</span>
                <div>
                  <h3 class="agenda__title">{item.title}</h3>
                  {item.detail && <p class="agenda__detail">{item.detail}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {/* ---- Photos ---- */}
  {
    showPhotos && (
      <section class:list={['band', `band--${bands.photos}`]} aria-labelledby="photos">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <hr class="dash" />
            <h2 id="photos">On the day</h2>
          </div>
          <div class="grid grid--2">
            {photos.map((photo, i) => (
              <figure class="photo" data-reveal data-reveal-delay={i * 80}>
                <Image src={photo.data.file} alt={photo.data.alt} widths={[480, 800, 1200]} sizes="(max-width: 48rem) 100vw, 46rem" loading="lazy" />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* ---- FAQ ---- */}
  {
    showFaq && (
      <section class:list={['band', `band--${bands.faq}`]} aria-labelledby="event-faq">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <hr class="dash" />
            <h2 id="event-faq">Questions</h2>
          </div>
          <div data-reveal>
            <Faq faqs={data.faqs} />
          </div>
        </div>
      </section>
    )
  }

  {/* ---- Final CTA ---- */}
  {
    !isPast && (
      <section class="band band--gold final-cta">
        <div class="wrap final-cta__inner">
          <div>
            <h2 class="final-cta__title">{registrationOpen ? 'Seats are limited.' : 'Seats will be limited.'}</h2>
            <p class="final-cta__copy">
              {data.capacity
                ? `Capped at ${data.capacity} so the day stays facilitated rather than lectured.`
                : 'A small cohort, so the day stays facilitated rather than lectured.'}
            </p>
          </div>
          <a
            href={bookHref}
            class="btn btn--onGold"
            rel={bookIsExternal ? 'noopener' : undefined}
            data-analytics-event={bookIsExternal ? 'luma_outbound_click' : undefined}
            data-analytics-slug={data.slug}
          >
            {registerLabel}
          </a>
        </div>
      </section>
    )
  }

  {/* ---- Sticky mobile bar ---- */}
  {
    !isPast && (
      <div class="sticky-bar">
        <span class="sticky-bar__date">{formatDate(data.startDate, { weekday: 'short', year: undefined })}</span>
        <a
          href={bookHref}
          class="btn btn--primary sticky-bar__cta"
          rel={bookIsExternal ? 'noopener' : undefined}
          data-analytics-event={bookIsExternal ? 'luma_outbound_click' : undefined}
          data-analytics-slug={data.slug}
        >
          {!registrationOpen ? 'Notify me' : status === 'soldout' ? 'Waitlist' : 'Book'}
        </a>
      </div>
    )
  }
</Base>

<style>
  .event-hero {
    padding-block: clamp(3rem, 2rem + 6vw, 5.5rem);
  }

  .event-hero h1 {
    max-width: 20ch;
    font-size: var(--step-2xl);
  }

  /* Set in the body face, not the label face the meta line uses: this is the
     one sentence in the hero meant to be read rather than scanned, and it has
     to win against a headline directly above it. */
  .event-hero__promise {
    margin-block-start: 1.4rem;
    max-width: 34ch;
    font-size: var(--step-lg);
    line-height: 1.45;
    color: var(--muted-on-dark);
  }

  .event-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: 1.6rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--step-xs);
    color: var(--muted-on-dark);
  }

  .sq {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--gold);
    flex: none;
  }

  /* ---- Key facts ---- */
  .facts-card {
    max-width: 62rem;
  }

  .capsule {
    font-family: var(--font-title);
    font-size: var(--step-lg);
    line-height: 1.4;
    max-width: 58ch;
  }

  .facts {
    display: grid;
    gap: 1.4rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    margin-block-start: 2rem;
    padding-block-start: 1.75rem;
    border-block-start: 1px solid var(--gold-hairline);
  }

  .facts--wide {
    grid-column: 1 / -1;
  }

  .facts dt {
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--step-xs);
    color: var(--rust);
    margin-block-end: 0.4rem;
  }

  :global(.band--dark) .facts dt {
    color: var(--gold);
  }

  .facts dd {
    margin: 0;
    font-size: var(--step-sm);
    line-height: 1.55;
  }

  .facts__note {
    display: block;
    margin-block-start: 0.3rem;
    font-size: var(--step-xs);
    opacity: 0.75;
  }

  .facts__programme {
    margin-block-start: 1.75rem;
    font-size: var(--step-sm);
  }

  /* ---- Stats ---- */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1rem;
    margin-block-start: 1.5rem;
    max-width: 62rem;
  }

  .stat {
    border: 1px solid var(--gold-hairline);
    border-radius: var(--radius);
    padding: 1.4rem;
  }

  :global(.band--cream) .stat {
    border-color: rgba(212, 175, 55, 0.75);
    background: rgba(255, 255, 255, 0.45);
  }

  .stat__value {
    display: block;
    font-family: var(--font-title);
    font-size: var(--step-2xl);
    line-height: 1;
  }

  .stat__label {
    display: block;
    margin-block-start: 0.55rem;
    font-family: var(--font-label);

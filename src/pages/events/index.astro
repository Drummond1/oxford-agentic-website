---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import EventCard from '../../components/EventCard.astro';
import config from '../../../site.config';
import { absoluteUrl, createRhythm, formatDate, getEventsForIndex, getProgrammes, paths } from '../../lib/site';
import { ogPathFor } from '../../lib/og';
import { collectionPageSchema, eventListingItem } from '../../lib/schema';

const { upcoming, past } = await getEventsForIndex();
const programmes = await getProgrammes();
const byId = new Map(programmes.map((p) => [p.id, p]));

const rhythm = createRhythm('cream');
const bands = { upcoming: rhythm.next(), past: past.length > 0 ? rhythm.next() : null };

/*
 * The meta description names the upcoming dates, and derives them rather than
 * stating them.
 *
 * This is the page titled "AI bootcamp dates in Oxford". Its description named
 * no date - "upcoming cohorts open for registration, and past cohorts with
 * their outcomes" - so a searcher who asked for dates was shown a snippet
 * promising that dates exist somewhere inside. The same field is the one an
 * answer engine quotes most readily, and the dates are already published in the
 * header and footer of every page on the site, so nothing new is asserted here.
 *
 * Derived from `upcoming`, which is why it cannot go stale the way a written
 * date does: a cohort leaves the sentence when its day passes and joins it when
 * one is added. Capped at three dates, and the second sentence is dropped if
 * the pair would pass the 160 characters a meta description gets.
 */
const nextDates = upcoming
  .slice(0, 3)
  .map((event) => formatDate(event.data.startDate, { weekday: undefined }));
const indexLine = `Every ${config.brand.name} cohort, upcoming and past, with its date and venue.`;

let description = `AI bootcamps and events in Oxford. ${indexLine}`;
if (nextDates.length > 0) {
  const dateLine =
    nextDates.length === 1
      ? `The next AI bootcamp in Oxford is on ${nextDates[0]}.`
      : `The next AI bootcamps in Oxford are on ${new Intl.ListFormat('en-GB', { type: 'conjunction' }).format(nextDates)}.`;
  description = `${dateLine} ${indexLine}`.length <= 160 ? `${dateLine} ${indexLine}` : dateLine;
}
---

<Base
  pageTitle="AI bootcamp dates in Oxford"
  description={description}
  path={paths.events()}
  ogImage={ogPathFor(paths.events())}
  schemaNodes={[
    collectionPageSchema(
      'Events',
      paths.events(),
      [...upcoming, ...past].map((event) => ({
        name: event.data.title,
        path: paths.event(event.data.slug),
        item: eventListingItem(event, absoluteUrl(ogPathFor(paths.event(event.data.slug)))),
      })),
    ),
  ]}
  breadcrumbs={[{ name: 'Events', path: paths.events() }]}
>
  <Hero
    eyebrow={`${config.brand.name} - Events`}
    title="Every cohort, past and upcoming"
    subline="Small, in-person, hands-on days in Oxford. Upcoming events are open for registration; past ones stay here with what came out of them."
  />

  <section class:list={['band', `band--${bands.upcoming}`]} aria-labelledby="upcoming">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <hr class="dash" />
        <h2 id="upcoming">Upcoming</h2>
      </div>

      {
        upcoming.length > 0 ? (
          <div class="grid grid--3">
            {upcoming.map((event, i) => (
              <div data-reveal data-reveal-delay={i * 80}>
                <EventCard event={event} programme={byId.get(event.data.programme.id)!} />
              </div>
            ))}
          </div>
        ) : (
          <p class="empty">
            Nothing is open for registration right now. The next cohort is being scheduled - the{' '}
            <a href={paths.programme(programmes[0].data.slug)}>{programmes[0].data.name}</a> page has the format, and how to hear about the next one.
          </p>
        )
      }
    </div>
  </section>

  {
    bands.past && (
      <section class:list={['band', `band--${bands.past}`]} aria-labelledby="past">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <hr class="dash" />
            <h2 id="past">Already run</h2>
            <p>Past cohorts stay online. Each one keeps its agenda and what came out of the day.</p>
          </div>

          <div class="grid grid--3">
            {past.map((event, i) => (
              <div data-reveal data-reveal-delay={i * 80}>
                <EventCard event={event} programme={byId.get(event.data.programme.id)!} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .empty {
    max-width: var(--measure);
    font-size: var(--step-lg);
    line-height: 1.5;
  }
</style>

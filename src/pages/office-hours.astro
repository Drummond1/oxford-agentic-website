---
/**
 * Office hours: ask AI Drummond anything we taught.
 *
 * Added 30 Sept 2026 at Drummond's request, as the teaching companion to
 * /find-your-bootcamp/. Same voice mechanism (ElevenLabs, Drummond's cloned
 * voice, WebSocket so the origin lock passes), but a different agent whose job
 * is answering questions: "Oxford Agentic - Office Hours (hidden page)", id in
 * `config.assistant.officeHoursAgentId`. Its primary knowledge is sanitised
 * teaching notes from Cohorts 1 and 2 (no attendee details, prices or business
 * figures), then the finder brief and the site text. When a visitor shows real
 * interest in attending, it uses the same show_bootcamp client tool to put the
 * right day and its Luma form on this page.
 *
 * Deliberately quiet: noindex, out of the sitemap and llms files, linked from
 * nowhere. Only Drummond links or promotes it.
 */
import Base from '../layouts/Base.astro';
import MicHelp from '../components/MicHelp.astro';
import config from '../../site.config';
import { getEvents, formatDate, venueLine, lumaEmbedSrc, lumaBookingUrl, paths, isUpcoming } from '../lib/site';

const agentId = config.assistant.officeHoursAgentId;

/** The agent's show_bootcamp keys, mapped to the event each one opens. */
const choices = [
  {
    key: 'second-brain',
    slug: 'oxford-second-brain-bootcamp-cohort-1',
  },
  {
    key: 'agentic-bootcamp',
    slug: 'oxford-agentic-bootcamp-cohort-3',
  },
  {
    key: 'coding-bootcamp',
    slug: 'oxford-agentic-coding-bootcamp-cohort-1',
  },
];

const events = await getEvents();
const bootcamps = choices
  .map((c) => {
    const event = events.find((e) => e.data.slug === c.slug);
    if (!event || !isUpcoming(event)) return null;
    const d = event.data;
    return {
      ...c,
      title: d.title,
      when: formatDate(d.startDate, { weekday: 'long', day: 'numeric', month: 'long' }),
      where: venueLine(d.venue),
      whatYoullBuild: (d.whatYoullBuild ?? []).slice(0, 3),
      eventPath: paths.event(d.slug),
      embed: d.lumaEventId ? lumaEmbedSrc(d.lumaEventId) : null,
      booking: d.lumaUrl ? lumaBookingUrl(d.lumaUrl) : null,
    };
  })
  .filter((b): b is NonNullable<typeof b> => b !== null);

const syllabus: [string, string, string, string][] = [
  ['01', 'Start with the job', 'Map it first: trigger, inputs, steps, judgement, output.', 'Walk me through the workflow map you teach.'],
  ['02', 'Context', 'Generic input, generic output. Give it yours.', 'What is context engineering, and where do I start?'],
  ['03', 'Skills', 'Explain it twice? Save it as a skill.', 'How do I write a good skill?'],
  ['04', 'Agents', 'A model with tools in a loop - and when not to use one.', "What's the difference between a workflow, an agent and a subagent?"],
  ['05', 'Human in the loop', 'Where judgement stays with you.', 'Where should the human stay in an agentic workflow?'],
  ['06', 'Into the organisation', 'From your laptop to your team, past IT and legal.', 'How do I take this into my organisation?'],
];
const starters = ['What will I build on the day?', 'Do I need to be technical?', 'Cowork or Claude Code?', 'How do I stop it making things up?'];
const ticks = Array.from({ length: 60 }, (_, i) => i);
---

<Base
  pageTitle="Office hours"
  description={`Ask an AI version of Drummond anything we teach at ${config.brand.name} - context, skills, agents, workflows - and how the bootcamps work.`}
  path="/office-hours/"
  noindex
  bodyClass="finder-page office-page"
>
  <section class="band band--dark finder office" aria-labelledby="finder-title" data-finder data-agent-id={agentId}>
    <div class="finder__grid" aria-hidden="true"></div>
    <div class="finder__halo" aria-hidden="true"></div>

    <div class="wrap finder__inner">
      <span class="eyebrow">Office hours <span class="open-now"><span class="open-now__dot" aria-hidden="true"></span>Open now</span></span>
      <hr class="dash" />
      <h1 class="finder__title" id="finder-title">Ask anything <em>we teach.</em></h1>
      <p class="finder__sub">Agentic AI, the bootcamps and the material we cover.</p>

      <div class="orb" data-orb data-state="idle">
        <svg class="orb__dial" viewBox="0 0 200 200" aria-hidden="true">
          {
            ticks.map((i) => (
              <line
                x1="100"
                y1={i % 5 === 0 ? 3 : 6}
                x2="100"
                y2="12"
                transform={`rotate(${i * 6} 100 100)`}
                class={i % 5 === 0 ? 'orb__tick orb__tick--major' : 'orb__tick'}
              />
            ))
          }
        </svg>
        <span class="orb__ring orb__ring--1" aria-hidden="true"></span>
        <span class="orb__ring orb__ring--2" aria-hidden="true"></span>
        <span class="orb__ring orb__ring--3" aria-hidden="true"></span>
        <span class="orb__core" aria-hidden="true"></span>

        <button class="orb__button" type="button" data-talk aria-pressed="false">
          <svg class="orb__icon orb__icon--mic" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="3" width="6" height="11" rx="3" />
            <path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.5 21h7" />
          </svg>
          <svg class="orb__icon orb__icon--end" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="7" y="7" width="10" height="10" />
          </svg>
          <span class="orb__label" data-talk-label>Tap to talk</span>
        </button>
      </div>

      <p class="finder__status" data-status role="status" aria-live="polite"></p>
      <MicHelp />

      <button class="mute" type="button" data-mute aria-pressed="false" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9v6h4l5 4V5L9 9H5z" /><path class="mute__x" d="M17 9l4 6M21 9l-4 6" /></svg>
        <span data-mute-label>Mute mic</span>
      </button>

      <div class="captions" data-captions hidden aria-live="polite">
        <p class="captions__user" data-caption-user></p>
        <p class="captions__agent" data-caption-agent></p>
        <div class="rate" data-rate hidden>
          <span class="rate__q" data-rate-q>Was that helpful?</span>
          <button type="button" class="rate__btn" data-rate-btn="up" aria-label="Yes, helpful">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 11v9H4v-9h3zm2 9h8.2a2 2 0 0 0 2-1.6l1.2-6A2 2 0 0 0 18.4 10H14V6a2 2 0 0 0-2-2l-3 7v9z" /></svg>
          </button>
          <button type="button" class="rate__btn" data-rate-btn="down" aria-label="No, not helpful">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 13V4h3v9h-3zm-2-9H6.8a2 2 0 0 0-2 1.6l-1.2 6A2 2 0 0 0 5.6 14H10v4a2 2 0 0 0 2 2l3-7V4z" /></svg>
          </button>
        </div>
      </div>

      <div class="pick" data-pick hidden>
        <span class="pick__eyebrow">Suggested for you</span>
        <p class="pick__title" data-pick-title></p>
        <p class="pick__when" data-pick-when></p>
        <button class="btn btn--primary pick__go" type="button" data-pick-go>
          See details and book <span class="pick__arrow" aria-hidden="true">↓</span>
        </button>
      </div>

      <div class="starters" aria-label="Questions to start with">
        <ul class="starters__list" role="list">
          {starters.map((q, i) => (
            <li style={`--i:${i}`}><button class="starter" type="button" data-ask={q}>{q}</button></li>
          ))}
        </ul>
      </div>

      <div class="finder__alt">
        <button class="finder__link" type="button" data-type-toggle aria-expanded="false" aria-controls="finder-type">
          Type instead
        </button>
        <form class="typebox" id="finder-type" data-type-form hidden>
          <label class="visually-hidden" for="finder-input">Your question for AI Drummond</label>
          <input
            id="finder-input"
            class="typebox__input"
            type="text"
            maxlength="600"
            autocomplete="off"
            placeholder="e.g. How do I give Claude my company's context?"
            data-type-input
          />
          <button class="btn btn--primary typebox__send" type="submit">Ask</button>
        </form>
      </div>

      <button class="floatend" type="button" data-float-end hidden>
        <span class="floatend__dot" aria-hidden="true"></span> End conversation
      </button>

      <details class="transcript" data-transcript-wrap hidden>
        <summary>Full transcript <span class="transcript__chev" aria-hidden="true"></span></summary>
        <ol class="transcript__log" data-transcript role="log" aria-label="Conversation"></ol>
        <button type="button" class="transcript__copy" data-copy>Copy transcript</button>
      </details>

      <p class="finder__fine">
        An AI in Drummond's cloned voice. Voice not recorded; transcripts
        kept 90 days. Voice by <a href="https://elevenlabs.io/" rel="noopener" target="_blank">ElevenLabs</a>.
      </p>
    </div>
  </section>

  <section class="band band--dark match" id="your-match" aria-labelledby="match-title" data-match hidden>
    <div class="wrap">
      <h2 class="visually-hidden" id="match-title">Your bootcamp</h2>
      {
        bootcamps.map((b) => (
          <article class="match__panel" data-panel={b.key} hidden>
            <div class="match__info">
              <h3 class="match__title">{b.title}</h3>
              <p class="match__when">
                {b.when} · 09:00 to 17:00
                <br />
                {b.where}
              </p>
              <blockquote class="match__reason" data-reason hidden>
                <p data-reason-text />
              </blockquote>
              {b.whatYoullBuild.length > 0 && (
                <ul class="match__builds" role="list">
                  {b.whatYoullBuild.map((w) => (
                    <li>{w}</li>
                  ))}
                </ul>
              )}
              <p class="match__more">
                <a href={b.eventPath}>Full details →</a>
              </p>
            </div>

            <div class="match__book">
              {b.embed ? (
                <div class="match__frame" data-frame>
                  <p class="match__loading" data-frame-loading>
                    Loading the booking form…
                  </p>
                  <iframe
                    data-src={b.embed}
                    width="600"
                    height="560"
                    title={`Register for ${b.title}`}
                    frameborder="0"
                    allow="fullscreen; payment"
                  />
                </div>
              ) : null}
              {b.booking && (
                <p class="match__fallback">
                  <a
                    href={b.booking}
                    rel="noopener"
                    data-analytics-event="luma_outbound_click"
                    data-analytics-slug={b.slug}
                  >
                    Open on Luma →
                  </a>
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="band band--cream syllabus" aria-labelledby="syllabus-title">
    <div class="wrap">
      <div class="section-head">
        <hr class="dash" />
        <h2 id="syllabus-title">What we teach</h2>
      </div>
      <ol class="syllabus__list" role="list" data-syllabus>
        {syllabus.map(([num, title, blurb, q], i) => (
          <li class="module" style={`--i:${i}`}>
            <span class="module__num">{num}</span>
            <h3 class="module__title">{title}</h3>
            <p class="module__blurb">{blurb}</p>
            <button class="option__btn" type="button" data-ask={q}>
              Ask <span aria-hidden="true">→</span>
            </button>
          </li>
        ))}
      </ol>
      <p class="syllabus__more">
        <button class="syllabus__link" type="button" data-ask="I'd like to come to a bootcamp - which one would suit me?">Which bootcamp suits me? →</button>
      </p>
    </div>
  </section>


</Base>

<script>
  import type { Conversation as ElevenLabsConversation } from '@elevenlabs/client';
  import { track } from '../lib/track';
  import { detectMicEnv, micAskLine, micHelpCopy, micProblemFrom, type MicProblem } from '../lib/mic';

  type Kind = 'voice' | 'text';
  type Role = 'user' | 'agent';

  const root = document.querySelector<HTMLElement>('[data-finder]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const agentId = root.dataset.agentId ?? '';
    const orb = root.querySelector<HTMLElement>('[data-orb]')!;
    const talk = root.querySelector<HTMLButtonElement>('[data-talk]')!;
    const talkLabel = root.querySelector<HTMLElement>('[data-talk-label]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const captions = root.querySelector<HTMLElement>('[data-captions]')!;
    const capAgent = root.querySelector<HTMLElement>('[data-caption-agent]')!;
    const capUser = root.querySelector<HTMLElement>('[data-caption-user]')!;
    const typeToggle = root.querySelector<HTMLButtonElement>('[data-type-toggle]')!;
    const typeForm = root.querySelector<HTMLFormElement>('[data-type-form]')!;
    const typeInput = root.querySelector<HTMLInputElement>('[data-type-input]')!;
    const transcriptWrap = root.querySelector<HTMLDetailsElement>('[data-transcript-wrap]')!;
    const transcript = root.querySelector<HTMLOListElement>('[data-transcript]')!;
    const match = document.querySelector<HTMLElement>('[data-match]')!;
    const pick = root.querySelector<HTMLElement>('[data-pick]')!;
    const pickTitle = root.querySelector<HTMLElement>('[data-pick-title]')!;
    const pickWhen = root.querySelector<HTMLElement>('[data-pick-when]')!;
    const pickGo = root.querySelector<HTMLButtonElement>('[data-pick-go]')!;
    const floatEnd = root.querySelector<HTMLButtonElement>('[data-float-end]')!;
    const muteBtn = root.querySelector<HTMLButtonElement>('[data-mute]')!;
    const muteLabel = root.querySelector<HTMLElement>('[data-mute-label]')!;
    const rate = root.querySelector<HTMLElement>('[data-rate]')!;
    const rateQ = root.querySelector<HTMLElement>('[data-rate-q]')!;
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]')!;

    const NO_CONNECT = "Couldn't connect - try again, or type instead";
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    // "Tap" on phones, "Click" with a mouse.
    const TAP = finePointer ? 'Click' : 'Tap';
    const tap = TAP.toLowerCase();
    const endedMessage = () =>
      shownKey ? 'Ended - your suggested bootcamp is below' : `Ended - ${tap} to talk again`;
    talkLabel.textContent = `${TAP} to talk`;

    // ---- Micro-interactions ---------------------------------------------------
    // Small, quick and optional: every one is skipped under reduced motion, and a
    // light haptic tick is added on phones that support it (Android; iOS ignores).
    const buzz = (pattern: number | number[]) => {
      if (reduceMotion) return;
      try {
        navigator.vibrate?.(pattern);
      } catch {
        /* Not supported. */
      }
    };
    // Astro scopes this page's CSS with a data-astro-cid attribute. Elements the
    // script creates don't get it, so copy it on, or their styles never apply.
    const cid = [...orb.attributes].map((a) => a.name).filter((n) => n.startsWith('data-astro-cid-'));
    const scoped = <T extends Element>(el: T): T => {
      cid.forEach((n) => el.setAttribute(n, ''));
      return el;
    };
    const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string) =>
      scoped(Object.assign(document.createElement(tag), { className }));

    const replay = (el: Element, cls: string) => {
      el.classList.remove(cls);
      void (el as HTMLElement).offsetWidth;
      el.classList.add(cls);
    };

    /** Agent captions arrive word by word, quickly, like someone speaking. */
    function setCaption(text: string) {
      capAgent.classList.remove('is-new');
      if (reduceMotion) {
        capAgent.textContent = text;
        return;
      }
      capAgent.textContent = '';
      const words = text.split(/(\s+)/);
      const step = Math.max(12, Math.min(35, 900 / Math.max(1, words.length / 2)));
      let n = 0;
      for (const w of words) {
        if (!w.trim()) {
          capAgent.append(w);
          continue;
        }
        const span = make('span', 'cap-word');
        span.style.setProperty('--d', `${Math.round(n++ * step)}ms`);
        span.textContent = w;
        capAgent.append(span);
      }
    }

    /** A small burst of gold sparks from the orb when a bootcamp is suggested. */
    function celebrate() {
      if (reduceMotion) return;
      const count = 10;
      for (let i = 0; i < count; i++) {
        const spark = make('span', 'orb__spark');
        spark.setAttribute('aria-hidden', 'true');
        const angle = (360 / count) * i + Math.random() * 18;
        spark.style.setProperty('--a', `${angle}deg`);
        spark.style.setProperty('--r', (0.32 + Math.random() * 0.14).toFixed(2));
        spark.style.setProperty('--d', `${Math.round(Math.random() * 120)}ms`);
        orb.append(spark);
        spark.addEventListener('animationend', () => spark.remove(), { once: true });
      }
      replay(orb, 'is-celebrate');
    }

    // The tab title shows a live call, so it's easy to find again.
    const baseTitle = document.title;
    const syncTitle = () => {
      document.title = kind === 'voice' ? `${muted ? 'Paused' : '●'} ${baseTitle}` : baseTitle;
    };

    // Rotate example questions through the empty type box.
    const examples = [
      "e.g. How do I give Claude my company's context?",
      'e.g. When should I use an agent, not a workflow?',
      'e.g. How do I write a good skill?',
      'e.g. How do I get this past IT?',
    ];
    let exampleIndex = 0;
    window.setInterval(() => {
      if (typeForm.hidden || typeInput.value || document.activeElement === typeInput) return;
      exampleIndex = (exampleIndex + 1) % examples.length;
      typeInput.placeholder = examples[exampleIndex];
      if (!reduceMotion) replay(typeInput, 'is-swap');
    }, 3800);
    typeInput.addEventListener('input', () => typeForm.classList.toggle('has-text', typeInput.value.trim() !== ''));

    // The orb leans gently toward the cursor on desktop.
    if (finePointer && !reduceMotion) {
      let pending = 0;
      window.addEventListener(
        'pointermove',
        (e) => {
          if (pending) return;
          pending = requestAnimationFrame(() => {
            pending = 0;
            const r = orb.getBoundingClientRect();
            const cx = r.left + r.width / 2;
            const cy = r.top + r.height / 2;
            const dx = e.clientX - cx;
            const dy = e.clientY - cy;
            const reach = r.width * 0.9;
            const dist = Math.hypot(dx, dy);
            const pull = dist < reach ? 1 - dist / reach : 0;
            orb.style.setProperty('--mx', `${((dx / reach) * 10 * pull).toFixed(2)}px`);
            orb.style.setProperty('--my', `${((dy / reach) * 10 * pull).toFixed(2)}px`);
          });
        },
        { passive: true },
      );
    }

    // A gold ripple from the orb on every press.
    talk.addEventListener('pointerdown', () => {
      if (reduceMotion) return;
      const burst = make('span', 'orb__burst');
      burst.setAttribute('aria-hidden', 'true');
      orb.append(burst);
      burst.addEventListener('animationend', () => burst.remove(), { once: true });
      buzz(8);
    });

    // Starter chips flash gold when sent.
    document.querySelectorAll<HTMLButtonElement>('.starter').forEach((chip) =>
      chip.addEventListener('click', () => {
        replay(chip, 'is-sent');
        buzz(6);
        window.setTimeout(() => chip.classList.remove('is-sent'), 900);
      }),
    );

    // Syllabus modules rise in as they scroll into view, with a soft gold
    // spotlight that follows the cursor on desktop.
    const syllabusList = document.querySelector<HTMLElement>('[data-syllabus]');
    if (syllabusList && !reduceMotion && 'IntersectionObserver' in window) {
      syllabusList.classList.add('reveal-ready');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((en) => {
            if (!en.isIntersecting) return;
            en.target.classList.add('is-visible');
            io.unobserve(en.target);
          }),
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
      );
      syllabusList.querySelectorAll('.module').forEach((m) => io.observe(m));
    }
    if (syllabusList && finePointer) {
      syllabusList.querySelectorAll<HTMLElement>('.module').forEach((m) =>
        m.addEventListener('pointermove', (e) => {
          const r = m.getBoundingClientRect();
          m.style.setProperty('--px', `${e.clientX - r.left}px`);
          m.style.setProperty('--py', `${e.clientY - r.top}px`);
        }),
      );
    }

    let conversation: ElevenLabsConversation | null = null;
    let kind: Kind | null = null;
    let session = 0;
    let mode: 'speaking' | 'listening' = 'listening';
    let raf = 0;
    const echoes: string[] = [];
    const norm = (s: string) => s.toLowerCase().replace(/\s+/g, ' ').trim();

    function setState(state: 'idle' | 'connecting' | 'listening' | 'speaking' | 'text') {
      orb.dataset.state = state;
    }

    function setStatus(text: string) {
      if (status.textContent === text) return;
      status.textContent = text;
      status.classList.toggle('is-busy', /^(Thinking|Connecting)$/.test(text));
      if (text && !reduceMotion) replay(status, 'is-swap');
    }

    // ---- Microphone help ------------------------------------------------------
    // Blocked, missing or busy mics, and in-app browsers (LinkedIn, Instagram...)
    // that can't use the mic at all, each get plain steps for that device.
    const micEnv = detectMicEnv();
    const micHelp = root.querySelector<HTMLElement>('[data-mic-help]')!;
    const micTitle = micHelp.querySelector<HTMLElement>('[data-mic-title]')!;
    const micSteps = micHelp.querySelector<HTMLElement>('[data-mic-steps]')!;
    const micCopy = micHelp.querySelector<HTMLButtonElement>('[data-mic-copy]')!;
    let micState: PermissionState | '' = '';

    function showMicHelp(problem: MicProblem) {
      const { title, steps } = micHelpCopy(problem, micEnv);
      micTitle.textContent = title;
      micSteps.textContent = steps;
      micCopy.hidden = problem !== 'inapp';
      micHelp.hidden = false;
      setStatus('');
      // Keep it clear of the cookie banner on small screens.
      requestAnimationFrame(() =>
        micHelp.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' }),
      );
      buzz(20);
      track('mic_help_shown', { problem, in_app: micEnv.inApp || 'no' });
    }
    const hideMicHelp = () => (micHelp.hidden = true);
    micHelp.querySelector('[data-mic-retry]')!.addEventListener('click', () => {
      hideMicHelp();
      talk.click();
    });
    micHelp.querySelector('[data-mic-type]')!.addEventListener('click', () => {
      hideMicHelp();
      openTyping();
    });
    micCopy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href.split('#')[0]);
        micCopy.textContent = 'Copied';
      } catch {
        micCopy.textContent = 'Copy failed';
      }
      window.setTimeout(() => (micCopy.textContent = 'Copy link'), 2500);
    });

    // Before a call, flag a blocked mic or an in-app browser on the status line.
    if (micEnv.inApp) {
      setStatus(`Voice may not work inside ${micEnv.inApp} - open in ${micEnv.platform === 'ios' ? 'Safari' : 'Chrome'} or type`);
    }
    navigator.permissions
      ?.query({ name: 'microphone' as PermissionName })
      .then((p) => {
        const apply = () => {
          micState = p.state;
          if (kind) return;
          if (p.state === 'denied') setStatus(`Mic blocked - ${tap} to see how to allow it`);
          else if (p.state === 'granted' && !micHelp.hidden) {
            hideMicHelp();
            setStatus(`Mic on - ${tap} to talk`);
          } else if (status.textContent?.startsWith('Mic blocked')) setStatus('');
        };
        apply();
        p.addEventListener?.('change', apply);
      })
      .catch(() => {});

    function setTalk(active: boolean) {
      talk.setAttribute('aria-pressed', String(active));
      talkLabel.textContent = active ? 'End' : `${TAP} to talk`;
    }

    const starterWrap = root.querySelector<HTMLElement>('.starters')!;

    function addLine(role: Role, text: string) {
      // The starter chips have done their job once the visitor has asked something.
      if (role === 'user') awaitingAnswer = true;
      if (role === 'user' && !starterWrap.hidden && !starterWrap.classList.contains('is-leaving')) {
        starterWrap.classList.add('is-leaving');
        window.setTimeout(() => (starterWrap.hidden = true), reduceMotion ? 0 : 260);
      }
      const li = make('li', `transcript__line transcript__line--${role}`);
      const who = make('span', 'transcript__who');
      who.textContent = role === 'agent' ? 'AI Drummond' : 'You';
      const body = scoped(document.createElement('span'));
      body.textContent = text;
      li.append(who, body);
      transcript.append(li);
      transcriptWrap.hidden = false;
      captions.hidden = false;
      if (role === 'agent') {
        setCaption(text);
      } else {
        capUser.textContent = `You: ${text}`;
        if (!reduceMotion) replay(capUser, 'is-new');
      }
    }

    // ---- The reveal ---------------------------------------------------------

    let shownKey = '';
    let shownByAgent = false;

    /**
     * Keeps the card in step with what the agent says. If it recommends one
     * bootcamp by name (and only one) but skipped the show_bootcamp tool, or the
     * card on screen is a different one, open the bootcamp it actually named.
     * "Agentic Bootcamp" must not match "Agentic Coding Bootcamp".
     */
    const spoken: [RegExp, string][] = [
      [/second brain boot ?camp/i, 'second-brain'],
      [/coding boot ?camp/i, 'coding-bootcamp'],
      [/agentic boot ?camp/i, 'agentic-bootcamp'],
    ];
    const recommending =
      /\b(below|suits?|fit|for you|recommend|exactly what|is for|built for|that's where|I'd start|I'd suggest|right one)\b/i;
    function revealFromSpeech(text: string) {
      const named = spoken.filter(([re]) => re.test(text)).map(([, key]) => key);
      if (named.length !== 1 || !recommending.test(text)) return;
      if (named[0] !== shownKey) reveal(named[0], '');
    }

    /** A new conversation starts clean: no suggestion left over from the last one. */
    function clearAgentPick() {
      if (!shownByAgent) return;
      shownKey = '';
      shownByAgent = false;
      pick.hidden = true;
      match.hidden = true;
      match.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = true));
    }

    function reveal(key: string, reason?: string) {
      const panel = match.querySelector<HTMLElement>(`[data-panel="${key}"]`);
      if (!panel) return false;

      shownKey = key;
      shownByAgent = reason !== undefined;
      match.hidden = false;
      match.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p !== panel));

      const quote = panel.querySelector<HTMLElement>('[data-reason]')!;
      if (reason && reason.trim()) {
        panel.querySelector<HTMLElement>('[data-reason-text]')!.textContent = reason.trim();
        quote.hidden = false;
      } else {
        quote.hidden = true;
      }

      const iframe = panel.querySelector<HTMLIFrameElement>('iframe[data-src]');
      if (iframe && !iframe.src) {
        const frame = iframe.closest<HTMLElement>('[data-frame]')!;
        const loading = frame.querySelector<HTMLElement>('[data-frame-loading]')!;
        const done = () => {
          frame.classList.add('is-loaded');
          window.setTimeout(() => (loading.hidden = true), 400);
        };
        iframe.addEventListener('load', done, { once: true });
        window.setTimeout(done, 6000);
        iframe.src = iframe.dataset.src!;
      }

      panel.classList.remove('is-in');
      void panel.offsetWidth;
      panel.classList.add('is-in');

      // Agent picks land as a small card under the orb, so the visitor keeps
      // the conversation (and the End button) in view. Only a visitor's own
      // tap scrolls them down to the booking form.
      const fromAgent = reason !== undefined;
      if (fromAgent) {
        pickTitle.textContent = panel.querySelector('.match__title')?.textContent?.trim() ?? '';
        pickWhen.textContent = (panel.querySelector('.match__when')?.textContent ?? '').replace(/\s+/g, ' ').trim();
        pick.hidden = false;
        replay(pick, 'is-in');
        buzz([10, 50, 14]);
        celebrate();
      } else {
        match.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      }
      track('office_bootcamp_shown', { bootcamp: key, via: reason ? 'agent' : reason === '' ? 'agent_speech' : 'visitor' });
      return true;
    }

    // ---- The orb follows the voice -----------------------------------------

    function loop() {
      cancelAnimationFrame(raf);
      const tick = () => {
        let level = 0;
        if (conversation && kind === 'voice') {
          try {
            level = mode === 'speaking' ? conversation.getOutputVolume() : conversation.getInputVolume();
          } catch {
            level = 0;
          }
        }
        orb.style.setProperty('--level', Math.min(1, level * 1.8).toFixed(3));
        raf = requestAnimationFrame(tick);
      };
      if (!reduceMotion) raf = requestAnimationFrame(tick);
    }

    pickGo.addEventListener('click', () => {
      track('office_pick_opened', { bootcamp: shownKey });
      match.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      const panel = match.querySelector<HTMLElement>(`[data-panel="${shownKey}"]`);
      if (panel && !reduceMotion) window.setTimeout(() => replay(panel, 'is-arrived'), 550);
    });

    // When a voice call is live and the orb has scrolled out of view, keep an
    // End button on screen so nobody is left talking to a page they can't stop.
    let orbVisible = true;
    const syncFloat = () => {
      floatEnd.hidden = !(kind === 'voice' && !orbVisible);
      // Keep the cookie banner out of the way while a conversation is live.
      document.body.classList.toggle('is-talking', kind !== null);
      syncMute();
      orb.toggleAttribute('data-muted', muted && kind === 'voice');
      syncTitle();
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        orbVisible = entry.isIntersecting;
        syncFloat();
      }).observe(orb);
    }
    floatEnd.addEventListener('click', async () => {
      await end();
      setTalk(false);
      setStatus(endedMessage());
      syncFloat();
    });

    // ---- Mute: a pause button for noisy rooms ------------------------------

    let muted = false;
    let keepAlive = 0;
    function setMuted(next: boolean) {
      muted = next;
      muteBtn.setAttribute('aria-pressed', String(next));
      muteLabel.textContent = next ? 'Unmute' : 'Mute mic';
      orb.toggleAttribute('data-muted', next);
      syncTitle();
      try {
        conversation?.setMicMuted(next);
      } catch {
        /* Text sessions have no mic. */
      }
      window.clearInterval(keepAlive);
      if (next) {
        setStatus('Paused - tap Unmute to carry on');
        // Tell the agent the visitor is still here, so a pause doesn't
        // trigger "Are you still there?".
        keepAlive = window.setInterval(() => {
          try {
            conversation?.sendUserActivity();
          } catch {
            /* Closed. */
          }
        }, 15000);
      } else if (kind === 'voice') {
        setStatus(mode === 'speaking' ? 'Speaking' : 'Listening');
      }
      track(next ? 'office_mic_muted' : 'office_mic_unmuted');
    }
    muteBtn.addEventListener('click', () => setMuted(!muted));
    const syncMute = () => {
      muteBtn.hidden = kind !== 'voice';
      if (kind !== 'voice' && muted) {
        muted = false;
        window.clearInterval(keepAlive);
        muteBtn.setAttribute('aria-pressed', 'false');
        muteLabel.textContent = 'Mute mic';
      }
    };

    // ---- Feedback: one tap after each answer --------------------------------

    let canFeedback = false;
    let rated = false;
    let awaitingAnswer = false;
    function offerRating() {
      if (!awaitingAnswer) return;
      awaitingAnswer = false;
      rated = false;
      rateQ.textContent = 'Was that helpful?';
      rate.querySelectorAll('button').forEach((b) => {
        b.hidden = false;
        b.classList.remove('is-chosen');
      });
      rate.hidden = false;
    }
    rate.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-rate-btn]');
      if (!btn || rated) return;
      rated = true;
      const like = btn.dataset.rateBtn === 'up';
      if (conversation && canFeedback) {
        try {
          conversation.sendFeedback(like);
        } catch {
          /* Closed: the analytics event still records it. */
        }
      }
      track('office_answer_rated', { helpful: like ? 'yes' : 'no' });
      buzz(10);
      rate.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
        if (b !== btn) b.hidden = true;
      });
      btn.classList.add('is-chosen');
      window.setTimeout(
        () => {
          btn.hidden = true;
          btn.classList.remove('is-chosen');
          rateQ.textContent = like ? 'Thanks.' : 'Thanks - noted.';
          if (!reduceMotion) replay(rateQ, 'is-swap');
        },
        reduceMotion ? 0 : 550,
      );
    });

    // ---- Copy transcript -----------------------------------------------------

    copyBtn.addEventListener('click', async () => {
      const lines = [...transcript.querySelectorAll('li')].map((li) => {
        const [who, body] = li.querySelectorAll('span');
        return `${who?.textContent ?? ''}: ${body?.textContent ?? ''}`;
      });
      const text = `Oxford Agentic office hours\n\n${lines.join('\n\n')}`;
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.innerHTML =
          '<svg class="tick" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>Copied';
        copyBtn.querySelectorAll('svg, path').forEach((el) => scoped(el));
        copyBtn.classList.add('is-done');
        buzz(8);
      } catch {
        copyBtn.textContent = 'Copy failed - select the text above';
      }
      track('office_transcript_copied', { lines: lines.length });
      window.setTimeout(() => {
        copyBtn.textContent = 'Copy transcript';
        copyBtn.classList.remove('is-done');
      }, 2500);
    });

    // ---- Warm up the voice SDK so the first tap answers faster --------------

    let warmed = false;
    const warm = () => {
      if (warmed) return;
      warmed = true;
      void import('@elevenlabs/client').catch(() => (warmed = false));
    };
    talk.addEventListener('pointerenter', warm, { once: true });
    talk.addEventListener('touchstart', warm, { once: true, passive: true });
    talk.addEventListener('focus', warm, { once: true });
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (!saveData) {
      const idle = (window as Window & { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => number })
        .requestIdleCallback;
      window.addEventListener('load', () => {
        if (idle) idle(warm, { timeout: 4000 });
        else window.setTimeout(warm, 2500);
      });
    }

    // ---- The conversation ---------------------------------------------------

    async function begin(next: Kind) {
      const id = ++session;
      clearAgentPick();
      const { Conversation } = await import('@elevenlabs/client');
      if (id !== session) return;

      const options = {
        agentId,
        // WebSocket, not WebRTC: the agent only accepts oxfordagentic.com and
        // checks the Origin header, which WebRTC (LiveKit) sessions do not send.
        // With WebRTC every voice call failed at connect ("Client did not
        // provide the origin header") while typed chats worked.
        connectionType: 'websocket' as const,
        clientTools: {
          show_bootcamp: async (params: { bootcamp?: string; reason?: string }) => {
            const ok = reveal(String(params?.bootcamp ?? ''), params?.reason);
            return ok ? 'Shown on the page below the conversation.' : 'That bootcamp is not available on this page.';
          },
        },
        onMessage: ({ message, role }: { message: string; role: Role }) => {
          if (id !== session) return;
          const text = (message ?? '').trim();
          if (!text) return;
          if (role === 'user') {
            const i = echoes.indexOf(norm(text));
            if (i !== -1) {
              echoes.splice(i, 1);
              return;
            }
          }
          addLine(role, text);
          if (role === 'agent') {
            revealFromSpeech(text);
            offerRating();
          }
          if (role === 'agent' && kind === 'text') setStatus('');
        },
        onModeChange: ({ mode: m }: { mode: 'speaking' | 'listening' }) => {
          if (id !== session || kind !== 'voice') return;
          mode = m;
          setState(m);
          if (!muted) setStatus(m === 'speaking' ? 'Speaking' : 'Listening');
        },
        onCanSendFeedbackChange: ({ canSendFeedback }: { canSendFeedback: boolean }) => {
          if (id !== session) return;
          canFeedback = canSendFeedback;
        },
        onDisconnect: (details: { reason: string; message?: string; closeCode?: number; closeReason?: string }) => {
          if (id !== session) return;
          const was = kind;
          const why = `${details.closeReason ?? ''} ${details.message ?? ''}`;
          const blocked = /guardrail/i.test(why) || details.closeCode === 1008;
          conversation = null;
          kind = null;
          setState('idle');
          setTalk(false);
          cancelAnimationFrame(raf);
          orb.style.setProperty('--level', '0');
          syncFloat();
          if (blocked) {
            // The safety check stopped a reply mid-sentence. Say so kindly and
            // invite the next question rather than leaving a bare "Ended".
            captions.hidden = false;
            setCaption("That's one I can't go into here - ask me something else.");
            setStatus(was === 'text' ? 'Type another question' : `${TAP} to ask something else`);
            track('office_guardrail_stop');
            return;
          }
          setStatus(details.reason === 'error' ? `Connection dropped - ${tap} to try again` : endedMessage());
        },
        onError: (message: string) => console.warn('[finder]', message),
      };

      const started =
        next === 'text'
          ? await Conversation.startSession({ ...options, textOnly: true, overrides: { conversation: { textOnly: true } } })
          : await Conversation.startSession({ ...options, textOnly: false });

      if (id !== session) {
        void started.endSession();
        return;
      }
      conversation = started;
      kind = next;
      captions.hidden = false;
      document.body.classList.add('is-talking');
      syncFloat();
      track(next === 'voice' ? 'office_voice_start' : 'office_text_start');
    }

    async function end() {
      session++;
      const current = conversation;
      conversation = null;
      kind = null;
      cancelAnimationFrame(raf);
      orb.style.setProperty('--level', '0');
      setState('idle');
      if (current && !reduceMotion) replay(orb, 'is-settle');
      syncFloat();
      if (current) {
        try {
          await current.endSession();
        } catch {
          /* Already closed. */
        }
      }
    }

    talk.addEventListener('click', async () => {
      if (kind === 'voice' || orb.dataset.state === 'connecting') {
        await end();
        setTalk(false);
        setStatus(endedMessage());
        return;
      }
      if (!navigator.mediaDevices?.getUserMedia) {
        showMicHelp(micEnv.inApp ? 'inapp' : 'unsupported');
        return;
      }
      hideMicHelp();
      if (kind === 'text') await end();

      setTalk(true);
      setState('connecting');
      setStatus(micState === 'granted' ? 'Connecting' : micAskLine(micEnv));
      try {
        const probe = await navigator.mediaDevices.getUserMedia({ audio: true });
        probe.getTracks().forEach((t) => t.stop());
        setStatus('Connecting');
      } catch (error) {
        setTalk(false);
        setState('idle');
        showMicHelp(micProblemFrom(error, micEnv));
        return;
      }
      try {
        await begin('voice');
        if (!conversation) throw new Error('not connected');
        mode = 'listening';
        setState('listening');
        buzz([8, 60, 8]);
        loop();
      } catch {
        setTalk(false);
        setState('idle');
        setStatus(NO_CONNECT);
      }
    });

    function openTyping() {
      typeForm.hidden = false;
      typeToggle.setAttribute('aria-expanded', 'true');
      typeInput.focus();
    }

    typeToggle.addEventListener('click', () => {
      const open = typeForm.hidden;
      typeForm.hidden = !open;
      typeToggle.setAttribute('aria-expanded', String(open));
      if (open) typeInput.focus();
    });

    typeForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = typeInput.value;
      typeInput.value = '';
      typeForm.classList.remove('has-text');
      void sendText(text);
    });

    // Starter questions and syllabus buttons ask on the visitor's behalf, by
    // voice if a call is live, otherwise as a typed chat.
    document.querySelectorAll<HTMLButtonElement>('[data-ask]').forEach((btn) =>
      btn.addEventListener('click', () => {
        track('office_starter_asked', { question: btn.dataset.ask!.slice(0, 80) });
        root.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        void sendText(btn.dataset.ask!);
      }),
    );

    async function sendText(raw: string) {
      const text = raw.trim().slice(0, 600);
      if (!text) return;
      addLine('user', text);
      echoes.push(norm(text));
      setStatus('Thinking');
      try {
        if (kind === 'voice') {
          conversation?.sendUserMessage(text);
          return;
        }
        if (!conversation) {
          setState('text');
          await begin('text');
        }
        if (!conversation) throw new Error('not connected');
        conversation.sendUserMessage(text);
      } catch {
        setState('idle');
        setStatus(NO_CONNECT);
      }
    }

    window.addEventListener('pagehide', () => void end());

    // A direct link such as /office-hours/#coding-bootcamp opens that day.
    const fromHash = location.hash.replace('#', '');
    if (fromHash) reveal(fromHash);
  }
</script>

<style>
  /* ---- The stage ---------------------------------------------------------- */

  .finder {
    position: relative;
    overflow: clip;
    isolation: isolate;
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) clamp(3rem, 2rem + 4vw, 5rem);
    text-align: center;
  }

  .finder__grid {
    position: absolute;
    inset: -2px;
    z-index: -2;
    background-image:
      linear-gradient(to right, rgba(212, 175, 55, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(212, 175, 55, 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 20%, transparent 75%);
  }

  .finder__halo {
    position: absolute;
    left: 50%;
    top: 52%;
    width: min(70rem, 160vw);
    aspect-ratio: 1;
    translate: -50% -50%;
    z-index: -1;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.16) 0%, rgba(212, 175, 55, 0.05) 32%, transparent 62%);
    pointer-events: none;
  }

  .finder__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .finder__inner :global(.dash) {
    margin-inline: auto;
  }

  .finder__title {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: clamp(2.6rem, 1.6rem + 3.6vw, 4.1rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--cream);
    max-width: 18ch;
  }

  .finder__title em {
    font-style: italic;
    color: var(--gold);
  }

  .finder__sub {
    margin-top: 1.1rem;
    max-width: 46ch;
    font-size: var(--step-md);
    line-height: 1.55;
    color: var(--muted-on-dark);
  }

  /* ---- The orb ------------------------------------------------------------
     A dial of 60 ticks, three rings that breathe with the voice (the --level
     custom property is fed from the live input or output volume), and a
     gold core. The button is the whole centre of it. */

  .orb {
    --level: 0;
    --size: clamp(16rem, 11rem + 18vw, 23rem);
    position: relative;
    width: var(--size);
    aspect-ratio: 1;
    margin-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem) 1rem;
    display: grid;
    place-items: center;
  }

  .orb > * {
    grid-area: 1 / 1;
  }

  .orb__dial {
    width: 100%;
    height: 100%;
    animation: orb-spin 60s linear infinite;
  }

  .orb__tick {
    stroke: rgba(212, 175, 55, 0.35);
    stroke-width: 0.6;
  }

  .orb__tick--major {
    stroke: var(--gold);
    stroke-width: 1;
  }

  .orb__ring {
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid var(--gold-hairline);
    transform: scale(calc(1 + var(--level) * 0.14));
    transition: transform 90ms linear, border-color 400ms var(--ease);
  }

  .orb__ring--2 {
    width: 64%;
    transform: scale(calc(1 + var(--level) * 0.22));
  }

  .orb__ring--3 {
    width: 50%;
    border-color: rgba(212, 175, 55, 0.55);
    transform: scale(calc(1 + var(--level) * 0.3));
  }

  .orb__core {
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, rgba(255, 249, 236, 0.35), transparent 42%),
      radial-gradient(circle at 50% 55%, #e9c85a 0%, var(--gold) 45%, #8f7420 100%);
    box-shadow:
      0 0 calc(40px + var(--level) * 90px) rgba(212, 175, 55, calc(0.3 + var(--level) * 0.4)),
      inset 0 -10px 30px rgba(5, 24, 23, 0.35);
    transform: scale(calc(1 + var(--level) * 0.08));
    transition: transform 90ms linear, box-shadow 90ms linear, translate 260ms var(--ease);
  }

  .orb__button {
    z-index: 1;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 0;
    background: transparent;
    color: var(--ink-dark);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    cursor: pointer;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--step-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .orb__button:focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 6px;
  }

  .orb__icon {
    width: 2.2rem;
    height: 2.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .orb__icon--end {
    display: none;
    fill: currentColor;
    stroke: none;
  }

  .orb__label {
    max-width: 9ch;
    line-height: 1.3;
  }

  /* Idle: a slow invitation to press. */
  .orb[data-state='idle'] .orb__core {
    animation: orb-breathe 3.6s var(--ease) infinite;
  }

  .orb[data-state='idle'] .orb__ring--1 {
    animation: orb-ripple 3.6s var(--ease) infinite;
  }

  .orb[data-state='connecting'] .orb__dial {
    animation-duration: 4s;
  }

  .orb[data-state='connecting'] .orb__core {
    animation: orb-breathe 1.1s var(--ease) infinite;
  }

  .orb[data-state='listening'] .orb__ring,
  .orb[data-state='speaking'] .orb__ring {
    border-color: rgba(212, 175, 55, 0.6);
  }

  .orb[data-state='speaking'] .orb__dial {
    animation-duration: 18s;
  }

  .orb:is([data-state='listening'], [data-state='speaking'], [data-state='connecting']) .orb__icon--mic {
    display: none;
  }

  .orb:is([data-state='listening'], [data-state='speaking'], [data-state='connecting']) .orb__icon--end {
    display: block;
  }

  @keyframes orb-spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes orb-breathe {
    50% {
      transform: scale(1.045);
    }
  }

  @keyframes orb-ripple {
    0% {
      transform: scale(0.85);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: scale(1.12);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb__dial,
    .orb__core,
    .orb__ring {
      animation: none !important;
    }
  }

  .finder__status {
    min-height: 1.5em;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: var(--step-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* ---- Captions: the last thing said, large ------------------------------ */

  .captions {
    margin-top: 1.5rem;
    max-width: 40rem;
    min-height: 4.5rem;
  }

  .captions__agent {
    font-family: var(--font-title);
    font-style: italic;
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.55rem);
    line-height: 1.4;
    color: var(--cream);
  }

  .captions__agent.is-new {
    animation: caption-in 500ms var(--ease);
  }

  .captions__user {
    margin-top: 0.75rem;
    font-size: var(--step-sm);
    color: var(--muted-on-dark-dim);
  }

  @media (max-width: 40rem) {
    .captions__agent {
      font-size: 1.25rem;
    }
    .captions__user {
      font-size: 1rem;
      color: var(--muted-on-dark);
    }
  }

  /* ---- Mute, rating and copy -------------------------------------------- */

  .mute {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    font: inherit;
    font-size: var(--step-sm);
    color: var(--cream);
    background: transparent;
    border: 1px solid var(--gold-hairline);
    cursor: pointer;
  }

  .mute[hidden] {
    display: none;
  }

  .mute svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mute .mute__x {
    display: none;
  }

  .mute[aria-pressed='true'] {
    border-color: var(--gold);
    color: var(--gold);
  }

  .mute[aria-pressed='true'] .mute__x {
    display: inline;
  }

  .mute:focus-visible,
  .rate__btn:focus-visible,
  .transcript__copy:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .rate {
    margin-top: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: var(--step-sm);
    color: var(--muted-on-dark);
  }

  .rate[hidden],
  .rate__btn[hidden] {
    display: none;
  }

  .rate__btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: transparent;
    border: 1px solid var(--gold-hairline);
    color: var(--cream);
    cursor: pointer;
  }

  .rate__btn:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  .rate__btn svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .transcript__copy {
    margin-top: 0.75rem;
    padding: 0.45rem 0.85rem;
    font: inherit;
    font-size: var(--step-sm);
    color: var(--gold);
    background: transparent;
    border: 1px solid var(--gold-hairline);
    cursor: pointer;
  }

  /* ---- The pick: an agent recommendation, kept beside the conversation ---- */

  .pick {
    margin-top: 1.25rem;
    width: min(100%, 30rem);
    padding: 1rem 1.25rem;
    text-align: left;
    border: 1px solid var(--gold);
    background: rgba(212, 175, 55, 0.07);
  }

  .pick.is-in {
    animation: caption-in 500ms var(--ease);
  }

  .pick__eyebrow {
    font-family: var(--font-label);
    font-size: var(--step-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .pick__title {
    margin-top: 0.35rem;
    font-family: var(--font-title);
    font-size: var(--step-lg);
    line-height: 1.25;
    color: var(--cream);
  }

  .pick__when {
    margin-top: 0.25rem;
    font-size: var(--step-sm);
    color: var(--muted-on-dark);
  }

  .pick__go {
    margin-top: 0.85rem;
    width: 100%;
  }

  /* ---- Floating End, shown only mid-call with the orb off screen --------- */

  .floatend {
    position: fixed;
    z-index: 55;
    inset-block-end: max(1rem, env(safe-area-inset-bottom));
    inset-inline-end: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    font: inherit;
    font-size: var(--step-sm);
    color: var(--ink-dark);
    background: var(--gold);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
  }

  .floatend[hidden] {
    display: none;
  }

  .floatend__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--ink-dark);
    animation: floatend-pulse 1.4s ease-in-out infinite;
  }

  @keyframes floatend-pulse {
    50% {
      opacity: 0.3;
    }
  }

  /* ---- A slimmer cookie banner on this page only -------------------------- */

  :global(body.office-page .consent) {
    padding: 0.6rem 1rem;
  }

  :global(body.office-page.is-talking .consent) {
    display: none;
  }

  :global(body.office-page .consent__copy) {
    font-size: 0.75rem;
    line-height: 1.4;
  }

  :global(body.office-page .consent__inner) {
    gap: 0.5rem;
  }

  :global(body.office-page .consent__actions .btn) {
    padding-block: 0.4rem;
  }

  @keyframes caption-in {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  /* ---- Typing, transcript, small print ----------------------------------- */

  .finder__alt {
    margin-top: 1.75rem;
    width: min(100%, 36rem);
  }

  .finder__link {
    background: none;
    border: 0;
    padding: 0.25rem;
    cursor: pointer;
    font: inherit;
    font-size: var(--step-sm);
    color: var(--muted-on-dark);
    text-decoration: underline;
    text-decoration-color: var(--gold-hairline);
    text-underline-offset: 0.25em;
  }

  .finder__link:hover {
    color: var(--cream);
  }

  .typebox {
    margin-top: 0.9rem;
    display: flex;
    gap: 0.5rem;
  }

  .typebox[hidden] {
    display: none;
  }

  .typebox__input {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 0.95rem;
    font: inherit;
    font-size: var(--step-sm);
    color: var(--cream);
    background: rgba(255, 249, 236, 0.04);
    border: 1px solid var(--gold-hairline);
    border-radius: var(--radius);
  }

  .typebox__input::placeholder {
    color: var(--muted-on-dark-dim);
  }

  .typebox__input:focus {
    outline: none;
    border-color: var(--gold);
  }

  .transcript {
    margin-top: 1.5rem;
    width: min(100%, 40rem);
    text-align: left;
    border-top: 1px solid var(--gold-hairline);
    padding-top: 0.9rem;
  }

  .transcript summary {
    cursor: pointer;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: var(--step-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
  }

  .transcript__log {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: grid;
    gap: 0.75rem;
    max-height: 18rem;
    overflow-y: auto;
  }

  .transcript__line {
    display: grid;
    gap: 0.2rem;
    font-size: var(--step-sm);
    line-height: 1.5;
    color: var(--muted-on-dark);
  }

  .transcript__line--agent {
    color: var(--cream);
  }

  .transcript__who {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .finder__fine {
    margin-top: 2.25rem;
    max-width: 52ch;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted-on-dark-dim);
  }

  .finder__fine a {
    color: var(--muted-on-dark);
  }

  /* ---- The three options --------------------------------------------------- */

  .options__lede {
    max-width: 52ch;
    font-size: var(--step-md);
    line-height: 1.6;
    color: var(--muted-on-cream);
    margin-top: 0.75rem;
  }

  .options__list {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 0;
    border-top: 1px solid var(--hairline-cream);
  }

  .option {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem clamp(1rem, 0.5rem + 1.5vw, 1.75rem) 1.75rem 0;
    border-bottom: 1px solid var(--hairline-cream);
    transition: background-color 400ms var(--ease);
  }

  @media (min-width: 52rem) {
    .option + .option {
      padding-left: clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
      border-left: 1px solid var(--hairline-cream);
    }
  }

  .option::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 3px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease);
  }

  .option.is-chosen::before {
    transform: scaleX(1);
  }

  .option__num {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--step-xs);
    letter-spacing: 0.14em;
    color: var(--rust);
  }

  .option__ceiling {
    font-family: var(--font-title);
    font-style: italic;
    font-size: var(--step-lg);
    line-height: 1.35;
    color: var(--ink-dark);
  }

  .option__name {
    margin-top: 0.4rem;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--step-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dark);
  }

  .option__meta {
    font-size: var(--step-sm);
    color: var(--muted-on-cream);
  }

  .option__builds {
    font-size: var(--step-sm);
    line-height: 1.55;
    color: var(--muted-on-cream);
    flex: 1;
  }

  .option__btn {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.3rem 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rust);
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    font-size: var(--step-sm);
    color: var(--rust);
  }

  .option__btn:hover {
    color: var(--ink-dark);
    border-color: var(--ink-dark);
  }

  /* ---- The match ----------------------------------------------------------- */

  .match {
    scroll-margin-top: 4rem;
  }

  .match__panel {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 60rem) {
    .match__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 600px);
    }
  }

  .match__panel[hidden] {
    display: none;
  }

  .match__panel.is-in {
    animation: match-in 700ms var(--ease);
  }

  @keyframes match-in {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }

  .match__title {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: var(--step-2xl);
    line-height: 1.12;
    color: var(--cream);
  }

  .match__when {
    margin-top: 0.9rem;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: var(--step-xs);
    letter-spacing: 0.1em;
    line-height: 1.8;
    text-transform: uppercase;
    color: var(--gold);
  }

  .match__reason {
    margin: 1.6rem 0 0;
    padding: 1rem 0 1rem 1.25rem;
    border-left: 2px solid var(--gold);
  }

  .match__reason p {
    font-family: var(--font-title);
    font-style: italic;
    font-size: var(--step-lg);
    line-height: 1.45;
    color: var(--cream);
  }

  .match__promise {
    margin-top: 1.4rem;
    font-size: var(--step-md);
    line-height: 1.6;
    color: var(--muted-on-dark);
  }

  .match__builds {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: grid;
    gap: 0.6rem;
  }

  .match__builds li {
    position: relative;
    padding-left: 1.25rem;
    font-size: var(--step-sm);
    line-height: 1.55;
    color: var(--muted-on-dark);
  }

  .match__builds li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--gold);
  }

  .match__more {
    margin-top: 1.5rem;
    font-size: var(--step-sm);
  }

  .match__more a,
  .match__fallback a {
    color: var(--gold);
  }

  .match__frame {
    position: relative;
    width: 100%;
  }

  .match__frame iframe {
    display: block;
    width: 100%;
    height: 560px;
    border: 1px solid #d4af3755;
    border-radius: var(--radius);
    background: rgba(255, 249, 236, 0.03);
    color-scheme: light;
  }

  .match__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gold-hairline);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: var(--step-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-on-dark-dim);
    transition: opacity 320ms var(--ease);
  }

  .match__frame.is-loaded .match__loading {
    opacity: 0;
    pointer-events: none;
  }

  .match__loading[hidden] {
    display: none;
  }

  .match__fallback {
    margin-top: 1rem;
    font-size: var(--step-sm);
    color: var(--muted-on-dark);
  }
  /* ---- Office hours additions ------------------------------------------- */

  .office .finder__title {
    max-width: 20ch;
  }

  .starters[hidden] {
    display: none;
  }

  .starters {
    margin-top: 1.75rem;
    width: min(100%, 46rem);
  }

  .starters__label {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: var(--step-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-on-dark-dim);
  }

  .starters__list {
    list-style: none;
    padding: 0;
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .starter {
    padding: 0.55rem 0.9rem;
    font: inherit;
    font-size: var(--step-sm);
    line-height: 1.35;
    color: var(--cream);
    background: rgba(255, 249, 236, 0.03);
    border: 1px solid var(--gold-hairline);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color 200ms var(--ease), background-color 200ms var(--ease);
  }

  .starter:hover,
  .starter:focus-visible {
    border-color: var(--gold);
    background: rgba(212, 175, 55, 0.08);
    outline: none;
  }

  .syllabus__list {
    list-style: none;
    padding: 0;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    border-top: 1px solid var(--hairline-cream);
    border-left: 1px solid var(--hairline-cream);
  }

  .module {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem clamp(1rem, 0.5rem + 1.5vw, 1.6rem);
    border-right: 1px solid var(--hairline-cream);
    border-bottom: 1px solid var(--hairline-cream);
    transition: background-color 300ms var(--ease);
  }

  .module:hover {
    background: rgba(212, 175, 55, 0.06);
  }

  .module__num {
    font-family: var(--font-title);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--gold);
  }

  .module__title {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: var(--step-xl);
    line-height: 1.2;
    color: var(--ink-dark);
  }

  .module__blurb {
    flex: 1;
    font-size: var(--step-sm);
    line-height: 1.6;
    color: var(--muted-on-cream);
  }

  @media (max-width: 40rem) {
    .syllabus__list {
      grid-template-columns: 1fr 1fr;
    }
    .module {
      gap: 0.4rem;
      padding: 1rem 0.85rem;
    }
    .module__num {
      font-size: 1.5rem;
    }
    .module__title {
      font-size: var(--step-lg);
    }
    .module__blurb {
      line-height: 1.45;
    }
    .starter {
      font-size: var(--step-xs);
      padding: 0.5rem 0.75rem;
    }
  }

  .syllabus__more {
    margin-top: 2rem;
    font-size: var(--step-md);
    color: var(--muted-on-cream);
  }

  .syllabus__more a,
  .syllabus__link {
    color: var(--rust);
  }

  .syllabus__link {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  /* ---- Micro-interactions ---------------------------------------------------
     Quick (under 600ms), gold, and never in the way. Hover effects are desktop
     only; touch gets press states instead. All off under reduced motion. */

  .orb__core {
    translate: var(--mx, 0px) var(--my, 0px);
  }

  .orb__button {
    -webkit-tap-highlight-color: transparent;
    translate: calc(var(--mx, 0px) * 0.6) calc(var(--my, 0px) * 0.6);
    transition: translate 220ms var(--ease);
  }

  .orb__icon,
  .orb__label {
    transition: transform 160ms var(--ease);
  }

  .orb__button:active .orb__icon {
    transform: scale(0.88);
  }

  .orb__button:active .orb__label {
    transform: translateY(1px);
  }

  .orb__burst {
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid var(--gold);
    pointer-events: none;
    animation: orb-burst 650ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }

  @keyframes orb-burst {
    from {
      transform: scale(0.9);
      opacity: 0.9;
    }
    to {
      transform: scale(2.1);
      opacity: 0;
      border-width: 1px;
    }
  }

  /* Hero: the gold words underline themselves on arrival. */
  .finder__title em {
    background: linear-gradient(var(--gold), var(--gold)) no-repeat 0 92% / 0% 2px;
    animation: underline-in 900ms 450ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  @keyframes underline-in {
    to {
      background-size: 100% 2px;
    }
  }

  /* Status: each new state slides in; waiting states get three dots. */
  .finder__status.is-swap {
    animation: status-in 320ms var(--ease);
  }

  @keyframes status-in {
    from {
      opacity: 0;
      translate: 0 -4px;
      letter-spacing: 0.3em;
    }
  }

  .finder__status.is-busy::after {
    content: '';
    display: inline-block;
    width: 1.2em;
    text-align: left;
    animation: dots 1.2s steps(4, end) infinite;
  }

  @keyframes dots {
    0% {
      content: '';
    }
    25% {
      content: '.';
    }
    50% {
      content: '..';
    }
    75% {
      content: '...';
    }
  }

  /* Captions arrive word by word. */
  .cap-word {
    display: inline-block;
    animation: word-in 380ms var(--ease) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes word-in {
    from {
      opacity: 0;
      translate: 0 0.3em;
      filter: blur(3px);
    }
  }

  /* Starter chips: drift in on load, press down, flash gold when sent. */
  .starters__list li {
    animation: chip-in 500ms var(--ease) both;
    animation-delay: calc(300ms + var(--i, 0) * 60ms);
  }

  @keyframes chip-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  .starter {
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 200ms var(--ease),
      background-color 200ms var(--ease),
      transform 140ms var(--ease),
      color 200ms var(--ease);
  }

  .starter:active {
    transform: scale(0.96);
  }

  .starter.is-sent {
    animation: chip-sent 900ms var(--ease);
  }

  @keyframes chip-sent {
    0% {
      background: var(--gold);
      color: var(--ink-dark);
      border-color: var(--gold);
    }
    100% {
      background: rgba(212, 175, 55, 0.08);
    }
  }

  /* Mute: the cross draws itself. */
  .mute {
    -webkit-tap-highlight-color: transparent;
    transition: transform 140ms var(--ease), border-color 200ms var(--ease), color 200ms var(--ease);
  }

  .mute .mute__x {
    stroke-dasharray: 12;
    stroke-dashoffset: 12;
    transition: stroke-dashoffset 280ms var(--ease), opacity 120ms;
  }

  .mute[aria-pressed='true'] .mute__x {
    stroke-dashoffset: 0;
  }

  /* Rating: the chosen thumb pops and fills. */

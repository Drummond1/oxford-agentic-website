---
/**
 * Visible breadcrumb trail — the on-page twin of the BreadcrumbList JSON-LD.
 *
 * Both are rendered from the same array in Base.astro, so the markup and the
 * schema can never drift apart. It sits on ink above the dark hero, reading as
 * the top of that band rather than as a strip of its own.
 */
interface Props {
  trail: Array<{ name: string; path: string }>;
}

const { trail } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <div class="wrap">
    <ol class="crumbs__list">
      {
        trail.map((item, i) =>
          i === trail.length - 1 ? (
            <li class="crumbs__item crumbs__item--current">
              <span aria-current="page">{item.name}</span>
            </li>
          ) : (
            <li class="crumbs__item">
              <a href={item.path}>{item.name}</a>
            </li>
          ),
        )
      }
    </ol>
  </div>
</nav>

<style>
  .crumbs {
    background: var(--ink-dark);
    color: var(--muted-on-dark);
    padding-block-start: clamp(1.4rem, 1rem + 1.5vw, 2.1rem);
  }

  .crumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--step-xs);
  }

  .crumbs__item + .crumbs__item::before {
    content: '/';
    margin-inline-end: 0.6rem;
    color: var(--muted-on-dark-dim);
  }

  .crumbs__item a {
    color: var(--muted-on-dark);
    text-decoration: none;
    background: linear-gradient(var(--gold), var(--gold)) no-repeat left bottom / 0 1px;
    transition: color 200ms var(--ease), background-size 220ms var(--ease);
  }

  .crumbs__item a:hover,
  .crumbs__item a:focus-visible {
    color: var(--cream);
    background-size: 100% 1px;
  }

  /* The current page is named in full by the <h1> directly below, so the crumb
     stays on one line rather than wrapping a long guide title over three. */

  /* The span below truncates, but it never got the chance: as a flex item the
     <li> defaults to min-width:auto, so it refused to shrink below the full
     width of the untruncated title and pushed the document wider than the
     viewport. On a 375px screen the public-sector guide made the page 742px
     wide - a sideways scroll on every long-titled page. min-width:0 lets the
     item shrink, and the ellipsis then does its job. Found 11 Oct 2026. */
  .crumbs__item--current {
    min-width: 0;
    /* Flex, so the "/" this item draws and the page name are two items on one
       line and the name is the one that shrinks. It used to be an inline-block
       capped at a percentage of this <li>, which cannot work: the <li> is itself
       sized to its content, so the percentage resolved against a width the span
       had just decided, and the name lost its last character or two to an
       ellipsis on every page wide enough to show it in full. Subtracting the
       separator from that percentage made it worse, not better. Added 8 Nov 2026. */
    display: flex;
    align-items: baseline;
  }

  /* The 34ch cap this replaces was meant to let 34 characters through and never
     did: the row sets letter-spacing: 0.12em, which `ch` does not count, so a
     character occupies about 1.2ch and 34ch measured 265px against the 318px that
     34 uppercase characters actually need. The ellipsis therefore fired at about
     28 characters at every width - including 1280px, where the crumb row is
     1092px wide and the other crumbs use 141px of it. All five event pages cut
     their own cohort number ("The Oxford Agentic Bootcamp - Coh..."), which is
     the one word that tells those pages apart. 54ch is 421px, the width of the
     longest programme-or-cohort name on the site, so from 768px up those read in
     full; guide titles run to 77 characters and still truncate, which is what the
     cap is for - the <h1> directly below names the page in full. On a phone the
     flex line binds before the cap does, so mobile still ellipses, as the 11 Oct
     fix intended. Measured 8 Nov 2026. */
  .crumbs__item--current span {
    min-width: 0;
    max-width: 54ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--gold);
  }
</style>

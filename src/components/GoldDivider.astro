---
/**
 * The full-gold divider band with a giant Georgia numeral — the "01 / 02 / 03"
 * pattern from the deck (PRD §10). Sits outside the dark/cream alternation.
 */
interface Props {
  numeral: string;
  label: string;
  title?: string;
}

const { numeral, label, title } = Astro.props;
---

<section class="band band--gold divider">
  <div class="wrap divider__inner">
    {/* The numeral lands first and the words follow it in, which is the order a
        reader takes them anyway. Both use the sitewide reveal, so they inherit
        the reduced-motion behaviour and the keyboard safety net rather than
        inventing their own. */}
    <span class="divider__numeral" data-reveal aria-hidden="true">{numeral}</span>
    <div class="divider__text" data-reveal data-reveal-delay="110">
      <span class="eyebrow">{label}</span>
      {title && <p class="divider__title">{title}</p>}
    </div>
  </div>
</section>

<style>
  .divider {
    padding-block: clamp(2rem, 1.2rem + 3vw, 3.25rem);
  }

  .divider__inner {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 0.5rem + 3vw, 2.75rem);
  }

  .divider__numeral {
    font-family: var(--font-title);
    font-size: clamp(3.5rem, 2rem + 9vw, 8rem);
    line-height: 0.82;
    color: var(--ink-dark);
    opacity: 0.9;
    flex: none;
  }

  /*
   * Where scroll-driven animations exist, the numeral drifts up a little as the
   * band passes through the viewport: a printed numeral catching the light, not
   * a parallax showpiece. Its own scroll position is the timeline, so there is
   * no listener and nothing runs per frame. Browsers without support, and
   * anyone preferring reduced motion, see it sit still.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .divider__numeral {
        animation: numeral-drift linear both;
        animation-timeline: view();
      }
    }
  }

  @keyframes numeral-drift {
    from {
      transform: translateY(0.16em);
    }
    to {
      transform: translateY(-0.16em);
    }
  }

  .divider__text .eyebrow {
    margin-block-end: 0.4rem;
  }

  .divider__title {
    font-family: var(--font-title);
    font-size: var(--step-xl);
    line-height: 1.15;
    color: var(--ink-dark);
    max-width: 24ch;
  }
</style>

---
import NewsletterForm from './NewsletterForm.astro';
import { lumaEmbedSrc, lumaUrlWithUtm, showSection, type EventEntry } from '../lib/site';

/**
 * Registration — PRD §9.
 *
 * We cannot restyle Luma's internals, so we brand the frame, not the iframe:
 * a dark section, a Courier eyebrow, and a gold-tinted border replacing Luma's
 * default #bfcbda88.
 *
 * Three things are deliberate here:
 * - The fallback link is ALWAYS visible, not a JS-detected error state. If
 *    third-party content is blocked the visitor still has a way through.
 * - The iframe is lazy-loaded and given fixed dimensions, so it neither
 *    blocks LCP nor shifts layout when it paints.
 * - Every fact inside the embed also exists in the page's own HTML (the key
 *    facts card) because crawlers cannot read iframes.
 */
interface Props {
  event: EventEntry;
}

const { event } = Astro.props;
const { lumaEventId, lumaUrl, slug } = { ...event.data, slug: event.data.slug };

const fallbackHref = lumaUrl ? lumaUrlWithUtm(lumaUrl, slug) : null;
const showNotifyInstead = !lumaEventId;
const canNotify = showSection('newsletter');
---

<div class="register" data-register-section data-event-slug={slug}>
  <span class="eyebrow">Register</span>

  {
    showNotifyInstead ? (
      <div class="register__pending">
        <h2 class="register__pending-title">Registration opens shortly</h2>
        <p class="register__pending-copy">
          Booking for this cohort is being prepared. Leave your email and you will hear the moment it opens, before we
          announce it publicly.
        </p>
        {canNotify && <NewsletterForm label="Tell me when registration opens" cta="Notify me" />}
      </div>
    ) : (
      <div class="register__frame" data-embed-frame>
        {/* Sits behind the iframe so the booking area is never an empty box while
            Luma loads. Removed on the iframe's load event; if that never fires,
            the fallback link below is always present. */}
        <p class="register__loading" data-embed-loading>Loading the booking form…</p>
        <iframe
          data-embed-iframe
          src={lumaEmbedSrc(lumaEventId!)}
          width="600"
          height="450"
          title={`Register for ${event.data.title}`}
          loading="lazy"
          frameborder="0"
          allow="fullscreen; payment"
        />
      </div>
    )
  }

  {
    fallbackHref && (
      <p class="register__fallback">
        Having trouble?{' '}
        <a
          href={fallbackHref}
          rel="noopener"
          data-analytics-event="luma_outbound_click"
          data-analytics-slug={slug}
        >
          Register on Luma →
        </a>
      </p>
    )
  }
</div>

<script>
  // The embed is lazy-loaded, so this can be a real wait on the conversion path.
  // The placeholder goes as soon as Luma paints; if the load event never fires
  // (blocked third-party content), it is cleared anyway after a few seconds so
  // the visitor is pushed to the always-visible fallback link rather than a
  // stuck "loading" message.
  document.querySelectorAll<HTMLElement>('[data-embed-frame]').forEach((frame) => {
    const iframe = frame.querySelector<HTMLIFrameElement>('[data-embed-iframe]');
    const loading = frame.querySelector<HTMLElement>('[data-embed-loading]');
    if (!iframe || !loading) return;

    let settled = false;
    const done = () => {
      if (settled) return;
      settled = true;
      frame.classList.add('is-loaded');
      window.setTimeout(() => (loading.hidden = true), 400);
    };

    iframe.addEventListener('load', done, { once: true });
    window.setTimeout(done, 6000);
  });
</script>

<style>
  .register {
    max-width: 600px;
  }

  .register__frame {
    width: 100%;
    max-width: 600px;
    position: relative;
  }

  /* Placeholder occupies the same box as the iframe, so nothing shifts when the
     embed paints (CLS stays at zero).

     A gold sweep crosses it while Luma loads. This is the one place on the site
     where the visitor is waiting on somebody else's server at the exact moment
     they have decided to book, and a static line of text gives them no reason
     to believe anything is happening. The sweep is a single background-position
     animation on a gradient — no extra elements, nothing measured, and it stops
     the instant the iframe paints. */
  .register__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gold-hairline);
    font-family: var(--font-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--step-xs);
    color: var(--muted-on-dark-dim);
    transition: opacity 320ms var(--ease);

    background-image: linear-gradient(
      100deg,
      transparent 38%,
      rgba(212, 175, 55, 0.11) 50%,
      transparent 62%
    );
    background-size: 220% 100%;
    background-repeat: no-repeat;
    animation: register-sweep 1.9s var(--ease) infinite;
  }

  @keyframes register-sweep {
    from {
      background-position: 160% 0;
    }
    to {
      background-position: -60% 0;
    }
  }

  /* Stop the moment it has paid off, so a loaded form is never sitting behind a
     still-animating panel during the fade. */
  .register__frame.is-loaded .register__loading {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .register__loading {
      animation: none;
    }
  }

  .register__loading[hidden] {
    display: none;
  }

  .register__frame.is-loaded .register__loading {
    opacity: 0;
    pointer-events: none;
  }

  .register__frame iframe {
    width: 100%;
    /* Fixed height reserves the space before paint — no CLS (PRD §12). */
    height: 450px;
    display: block;
    border: 1px solid #d4af3755;
    border-radius: var(--radius);
    background: rgba(255, 249, 236, 0.03);
    color-scheme: light;
  }

  /* Luma's simple embed scrolls internally, so mobile gets more room. */
  @media (max-width: 40rem) {
    .register__frame iframe {
      height: 520px;
    }
  }

  .register__pending {
    border: 1px solid var(--gold-hairline);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
  }

  .register__pending-title {
    font-size: var(--step-xl);
  }

  .register__pending-copy {
    margin-block: 0.9rem 1.6rem;
    font-size: var(--step-sm);
    line-height: 1.6;
    color: var(--muted-on-dark);
    max-width: var(--measure);
  }

  .register__fallback {
    margin-block-start: 1.1rem;
    font-size: var(--step-sm);
    color: var(--muted-on-dark);
  }

  .register__fallback a {
    color: var(--gold);
  }
</style>

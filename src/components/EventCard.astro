---
import { effectiveStatus, formatDate, paths, venueLine, type EventEntry, type ProgrammeEntry } from '../lib/site';

interface Props {
  event: EventEntry;
  programme: ProgrammeEntry;
}

const { event, programme } = Astro.props;
const status = effectiveStatus(event);

const statusLabel: Record<string, string> = {
  upcoming: 'Register',
  soldout: 'Join the waitlist',
  past: 'See what happened',
  cancelled: 'Cancelled',
};
---

<a href={paths.event(event.data.slug)} class="card event-card">
  <span class="eyebrow event-card__programme">{programme.data.name}</span>
  <h3 class="event-card__title">{event.data.cohort ?? event.data.edition ?? event.data.title}</h3>

  <p class="event-card__meta">
    <span class="event-card__part">{formatDate(event.data.startDate)}</span>
    <span class="event-card__part">{venueLine(event.data.venue)}</span>
    {!event.data.venue.confirmed && <span class="event-card__tbc">venue to confirm</span>}
    {
      /* The cap is the honest scarcity signal — a real number from the event
         file, shown only while booking is open. */
      event.data.capacity && status === 'upcoming' && (
        <span class="event-card__part">{`Capped at ${event.data.capacity}`}</span>
      )
    }
  </p>

  <p class="event-card__summary">{event.data.summary}</p>

  <span class="event-card__cta">
    {statusLabel[status]}
    <span aria-hidden="true">→</span>
  </span>
</a>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .event-card__programme {
    margin-block-end: 0.7rem;
  }

  .event-card__title {
    font-size: var(--step-xl);
  }

  .event-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    /* The column gap holds the square and the 0.5rem that used to sit on each
       side of it when it was an item of its own: 0.5 + 0.4 + 0.5. The row gap
       is untouched, so a stacked line keeps its rhythm. */
    gap: 0.5rem 1.4rem;
    margin-block-start: 0.85rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--step-xs);
    line-height: 1.5;
    /* Clips the separator below when a part starts a line. */
    overflow: hidden;
    overflow: clip;
  }

  .event-card__part {
    position: relative;
  }

  /* The small coloured-square separator from the deck — drawn into the gap
     before each part after the first, not set between them as a flex item of
     its own.

     As its own item it wrapped with the line, and this line wraps on every
     card: measured on the built site, the square sat stranded after the date
     at 320-414px and alone on a line of its own at 1024-1440px, where the
     venue did not fit beside it. A separator that is not between anything is
     read as a stray mark. Drawn in the gap and clipped at the container's
     edge, it shows only where it is actually separating two parts on one line
     and disappears when they stack — the rendering at widths where the line
     already fits is unchanged. */
  .event-card__part ~ .event-card__part::before {
    content: '';
    position: absolute;
    /* Centred in the 1.4rem column gap: half the gap plus half the square. A
       part that starts a line puts this outside the content box, where the
       clip above takes it. */
    inset-inline-start: -0.9rem;
    /* The centre of the part's first line box (13px at line-height 1.5), so a
       part that wraps keeps its square beside its first line rather than
       between its two. */
    inset-block-start: 0.75em;
    translate: 0 -50%;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--gold);
    /* The squares grow in one after the other as the card reveals, the same
       rhythm the bullet squares keep. Without a revealing ancestor they are
       simply there. */
    transform-origin: center;
    transition: transform 300ms var(--ease) 260ms;
  }

  .event-card__part ~ .event-card__part ~ .event-card__part::before {
    transition-delay: 340ms;
  }

  :global(.js-motion [data-reveal]:not(.is-revealed)) .event-card__part ~ .event-card__part::before {
    transform: scale(0);
  }

  :global(.band--cream) .event-card__part ~ .event-card__part::before {
    background: var(--rust);
  }

  .event-card__tbc {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.42rem;
    border: 1px solid currentColor;
    border-radius: 0;
    opacity: 0.75;
  }

  .event-card__summary {
    margin-block-start: 1.1rem;
    font-size: var(--step-sm);
    line-height: 1.6;
    flex: 1;
  }

  :global(.band--dark) .event-card__summary {
    color: var(--muted-on-dark);
  }

  :global(.band--cream) .event-card__summary {
    color: var(--muted-on-cream);
  }

  .event-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: 1.6rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: var(--step-xs);
    color: var(--gold);
  }

  :global(.band--cream) .event-card__cta {
    color: var(--burnt);
  }

  /* focus-within as well as hover, so tabbing to the card nudges the arrow the
     same way pointing at it does. */
  .event-card:hover .event-card__cta span,
  .event-card:focus-within .event-card__cta span {
    transform: translateX(3px);
    display: inline-block;
    transition: transform 200ms var(--ease);
  }

  /* The arrow's shaft lengthens behind the head as it moves, so the nudge
     reads as the arrow reaching rather than the glyph sliding. A hairline in
     the arrow's own colour, grown from the head leftwards. */
  .event-card__cta span {
    position: relative;
  }

  .event-card__cta span::before {
    content: '';
    position: absolute;
    inset-inline-end: 0.5em;
    /* On the glyph's own shaft, which sits below the box's midline in Plex
       Mono; measured, not guessed. */
    inset-block-start: calc(50% + 0.17em);
    height: 1px;
    width: 0;
    background: currentColor;
    transition: width 220ms var(--ease);
  }

  .event-card:hover .event-card__cta span::before,
  .event-card:focus-within .event-card__cta span::before {
    width: 0.55em;
  }
</style>

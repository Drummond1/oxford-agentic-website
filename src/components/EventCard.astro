---
import { effectiveStatus, formatDate, paths, venueLine, type EventEntry, type ProgrammeEntry } from '../lib/site';

interface Props {
  event: EventEntry;
  programme: ProgrammeEntry;
}

const { event, programme } = Astro.props;
const status = effectiveStatus(event);

const statusLabel: Record<string, string> = {
  upcoming: 'Register',
  soldout: 'Join the waitlist',
  past: 'See what happened',
  cancelled: 'Cancelled',
};
---

<a href={paths.event(event.data.slug)} class="card event-card">
  {
    /* The programme name sits inside the heading, not beside it. The card's
       visible split is deliberate - programme name as the eyebrow, "Cohort 4"
       as the title - but as a sibling of the `h3` the name was outside the
       heading text, so the document outline read "Cohort 1, Cohort 4,
       Cohort 5" on `/` and, on `/events/`, "Cohort 1" three times for three
       different bootcamps. Someone navigating by heading was given no way to
       tell the Coding day from the Agentic one. Nesting puts the name in the
       heading and changes nothing else: the two elements, their order and
       their styles are the same, so the rendering is identical, and the
       link's accessible name reads the same words in the same order as
       before. Same fault and same remedy as the programme pages' runs
       heading, 16 November. */
  }
  <h3 class="event-card__title">
    <span class="eyebrow event-card__programme">{programme.data.name}</span>
    {event.data.cohort ?? event.data.edition ?? event.data.title}
  </h3>

  <p class="event-card__meta">
    <span class="event-card__part">{formatDate(event.data.startDate)}</span>
    <span class="event-card__part">{venueLine(event.data.venue)}</span>
    {
      /* `venue.confirmed` is false while the *booking* is provisional, not while
         the venue is in doubt: the schema field says so, the event page renders
         "Room booking being finalised." from the same flag, and the programme and
         homepage answers both carry the qualifier as "the room booking is being
         finalised". This chip said "venue to confirm" and sat directly under the
         venue line, so on the one card it applies to a reader saw "Jesus College,
         Oxford" and then read that the college itself might change. It names the
         room, as the rest of the site does. */
      !event.data.venue.confirmed && <span class="event-card__tbc">room booking to confirm</span>
    }
    {
      /* The cap is the honest scarcity signal — a real number from the event
         file, shown only while booking is open. */
      event.data.capacity && status === 'upcoming' && (
        <span class="event-card__part">{`Capped at ${event.data.capacity}`}</span>
      )
    }
  </p>

  <p class="event-card__summary">{event.data.summary}</p>

  <span class="event-card__cta">
    {statusLabel[status]}
    <span aria-hidden="true">→</span>
  </span>
</a>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .event-card__programme {
    margin-block-end: 0.7rem;
    /* The eyebrow is inside the `h3` now, and the sitewide heading rule sets
       `text-wrap: balance`, which is inherited. Pinned back to the value this
       label had as a sibling so a name that wraps breaks exactly where it did.
       Same correction as `:is(h2, h3).eyebrow` in `global.css`, which does it
       for an eyebrow that *is* a heading; this is the nested case. */
    text-wrap: wrap;
  }

  /* The programme name is the only row in this card whose height depends on
     what it says. Two of the three names wrap to a second line, and which ones
     wrap moves with the column count and with the fluid label size, so where
     cards sit side by side one card's eyebrow regularly takes one line and its
     neighbour's takes two - which puts every row below it, the cohort, the
     date, the venue and the standfirst, a line out of step with the card
     beside it.

     Measured on the built site over 24 widths on `/`, `/events/` and
     `/404.html`: the rows are out of step by 18px, one line, across
     760-880px and again across 1180-1320px, and 1280px sits in the second of
     those. Reserving the two lines makes the rhythm constant instead. No name
     has ever needed a third line - checked at every width from 706 to 1920 -
     and at most widths both names already wrap, so nothing moves there; the
     only place the reservation adds a line of air is roughly 900-992px, where
     every name happens to fit on one.

     Scoped to the multi-column layout, as the complement of the `max-width:
     44rem` query in `global.css` that drops `.grid--3` to one column: on a
     phone there is no neighbour to line up with, so the reservation would only
     push the cohort down. A rem query, so it follows the reader's own text
     size the way the grid's own breakpoints do. Where `lh` is not supported
     the declaration is dropped and the card renders as it did before. */
  @media (min-width: 44.0625rem) {
    .event-card__programme {
      min-block-size: 2lh;
    }
  }

  .event-card__title {
    font-size: var(--step-xl);
  }

  .event-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    /* The column gap holds the square and the 0.5rem that used to sit on each
       side of it when it was an item of its own: 0.5 + 0.4 + 0.5. The row gap
       is untouched, so a stacked line keeps its rhythm. */
    gap: 0.5rem 1.4rem;
    margin-block-start: 0.85rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--step-xs);
    line-height: 1.5;
    /* Clips the separator below when a part starts a line. */
    overflow: hidden;
    overflow: clip;
  }

  .event-card__part {
    position: relative;
  }

  /* The small coloured-square separator from the deck — drawn into the gap
     before each part after the first, not set between them as a flex item of
     its own.

     As its own item it wrapped with the line, and this line wraps on every
     card: measured on the built site, the square sat stranded after the date
     at 320-414px and alone on a line of its own at 1024-1440px, where the
     venue did not fit beside it. A separator that is not between anything is
     read as a stray mark. Drawn in the gap and clipped at the container's
     edge, it shows only where it is actually separating two parts on one line
     and disappears when they stack — the rendering at widths where the line
     already fits is unchanged. */
  .event-card__part ~ .event-card__part::before {
    content: '';
    position: absolute;
    /* Centred in the 1.4rem column gap: half the gap plus half the square. A
       part that starts a line puts this outside the content box, where the
       clip above takes it. */
    inset-inline-start: -0.9rem;
    /* The centre of the part's first line box (13px at line-height 1.5), so a
       part that wraps keeps its square beside its first line rather than
       between its two. */
    inset-block-start: 0.75em;
    translate: 0 -50%;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--gold);
    /* The squares grow in one after the other as the card reveals, the same
       rhythm the bullet squares keep. Without a revealing ancestor they are
       simply there. */
    transform-origin: center;
    transition: transform 300ms var(--ease) 260ms;
  }

  .event-card__part ~ .event-card__part ~ .event-card__part::before {
    transition-delay: 340ms;
  }

  :global(.js-motion [data-reveal]:not(.is-revealed)) .event-card__part ~ .event-card__part::before {
    transform: scale(0);
  }

  :global(.band--cream) .event-card__part ~ .event-card__part::before {
    background: var(--rust);
  }

  .event-card__tbc {
    /* Matches the meta line it sits in. This was 0.68rem (10.88px),
       16% under the scale's smallest step, and the only informative text on the
       public site set below it. The border, the tighter tracking and the opacity
       keep the chip subordinate to the date and venue it sits beside, so the
       size does not have to. */
    font-size: var(--step-xs);
    letter-spacing: 0.08em;
    padding: 0.15rem 0.42rem;
    border: 1px solid currentColor;
    border-radius: 0;
    opacity: 0.75;
  }

  .event-card__summary {
    margin-block-start: 1.1rem;
    font-size: var(--step-sm);
    line-height: 1.6;
    flex: 1;
  }

  :global(.band--dark) .event-card__summary {
    color: var(--muted-on-dark);
  }

  :global(.band--cream) .event-card__summary {
    color: var(--muted-on-cream);
  }

  .event-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: 1.6rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: var(--step-xs);
    color: var(--gold);
  }

  :global(.band--cream) .event-card__cta {
    color: var(--burnt);
  }

  /* focus-within as well as hover, so tabbing to the card nudges the arrow the
     same way pointing at it does. */
  .event-card:hover .event-card__cta span,
  .event-card:focus-within .event-card__cta span {
    transform: translateX(3px);
    display: inline-block;
    transition: transform 200ms var(--ease);
  }

  /* The arrow's shaft lengthens behind the head as it moves, so the nudge
     reads as the arrow reaching rather than the glyph sliding. A hairline in
     the arrow's own colour, grown from the head leftwards. */
  .event-card__cta span {
    position: relative;
  }

  .event-card__cta span::before {
    content: '';
    position: absolute;
    inset-inline-end: 0.5em;
    /* On the glyph's own shaft, which sits below the box's midline in Plex
       Mono; measured, not guessed. */
    inset-block-start: calc(50% + 0.17em);
    height: 1px;
    width: 0;
    background: currentColor;
    transition: width 220ms var(--ease);
  }

  .event-card:hover .event-card__cta span::before,
  .event-card:focus-within .event-card__cta span::before {
    width: 0.55em;
  }
</style>

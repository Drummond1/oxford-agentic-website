---
import { getCollection } from 'astro:content';
import config from '../../site.config';
import { absoluteUrl } from '../lib/site';
import { graph, organizationSchema, webPageSchema, websiteSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Site-relative path, used for the canonical URL. */
  path: string;
  ogImage?: string;
  /** Extra JSON-LD nodes for this page, merged into the sitewide @graph. */
  schemaNodes?: Array<Record<string, unknown> | null>;
  /** Present on long-form pages; switches og:type and adds the article dates. */
  article?: { publishedTime: Date; modifiedTime: Date; author?: string };
  noindex?: boolean;
}

const { title, description, path, ogImage, schemaNodes = [], article, noindex = false } = Astro.props;

const canonical = absoluteUrl(path);
const ogUrl = ogImage ? absoluteUrl(ogImage) : absoluteUrl('/og/index.png');

// The Organization's founder edge comes from whoever the team collection marks
// as host — a person fact sourced from content, not hardcoded here.
const host = (await getCollection('team', ({ data }) => data.isHost))[0];
const founder = host ? { name: host.data.name, slug: host.data.slug } : undefined;

// Organization and WebSite appear on every page — one entity, referenced by @id
// from every other node. Entity consistency is the core AI-citation signal (PRD §13).
// Each page also carries its own WebPage node tied into that graph — except
// noindex pages, which are deliberately not offered to crawlers as entities.
const pageNode = noindex
  ? null
  : webPageSchema({
      title,
      description,
      path,
      ogImage: ogUrl,
      publishedTime: article?.publishedTime,
      modifiedTime: article?.modifiedTime,
    });
const jsonLd = graph([organizationSchema(founder), websiteSchema(), pageNode, ...schemaNodes]);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#051817" />

{/* Preload the faces that paint above the fold, so first paint is in-brand
    rather than a swapped fallback:
      newsreader-400  - the hero heading (titles are never bold, PRD §10)
      plex-sans-400   - body copy
      plex-mono-600   - eyebrows
      plex-mono-700   - the header nav and EVERY .btn, including the hero CTA.
                        Missed until 31 Jul, so the most prominent interactive
                        text on every page swapped font after first paint. */}
<link rel="preload" href="/fonts/newsreader-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href="/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href="/fonts/plex-mono-600.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href="/fonts/plex-mono-700.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
{
  config.features.guides && (
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={`${config.brand.name} - Guides`} />
  )
}

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={config.brand.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_GB" />
{
  /* Article dates in the head as well as in the Article node: crawlers and
     social cards that never parse JSON-LD still read freshness and authorship. */
}
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
      {article.author && <meta property="article:author" content={article.author} />}
      <meta property="article:publisher" content={`${config.brand.domain}/`} />
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<script type="application/ld+json" is:inline set:html={jsonLd} />

{
  /* Analytics is provider-agnostic (PRD §14, §21) — swapping providers is a
     config change. Nothing loads while provider is 'none'. */
}
{
  config.analytics.provider === 'plausible' && (
    <script
      is:inline
      defer
      data-domain={config.analytics.siteId}
      src={config.analytics.scriptSrc ?? 'https://plausible.io/js/script.tagged-events.js'}
    />
  )
}
{
  config.analytics.provider === 'ga4' && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${config.analytics.siteId}`} />
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${config.analytics.siteId}');`} />
    </>
  )
}
{
  /* Consent Mode v2 defaults. Order is the whole point: this must execute
     before the container loads, because a default that arrives after the tag
     has already fired is not a default. Everything advertising-related starts
     denied; a stored choice is replayed here so a returning visitor is not
     re-asked and is not silently downgraded.

     ads_data_redaction strips ad click identifiers while consent is denied.
     url_passthrough keeps gclid in the URL across pages instead, so a click
     from an ad can still be attributed without a cookie. Together they are the
     difference between "denied" costing some measurement and costing all of it. */
  config.analytics.provider === 'gtm' && config.analytics.requireConsent !== false && (
    <script
      is:inline
      set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',functionality_storage:'granted',security_storage:'granted',wait_for_update:500});
gtag('set','ads_data_redaction',true);gtag('set','url_passthrough',true);
try{if(localStorage.getItem('oa-consent')==='granted'){gtag('consent','update',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted'})}}catch(e){}`}
    />
  )
}
{
  config.analytics.provider === 'gtm' && (
    <script
      is:inline
      set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f)})(window,document,'script','dataLayer','${config.analytics.siteId}');`}
    />
  )
}

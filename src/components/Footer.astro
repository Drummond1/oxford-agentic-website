---
import Wordmark from './Wordmark.astro';
import NewsletterForm from './NewsletterForm.astro';
import EmailAddress from './EmailAddress.astro';
import { getNav, getEventsForIndex, paths, formatShortDate, showSection } from '../lib/site';
import config from '../../site.config';

interface Props {
  /**
   * Set false by a page that already carries its own email capture, so the
   * same ask is not made twice on one page. The homepage's gold
   * "Not ready to book?" band and this one render the identical label and,
   * with no endpoint configured, the identical fallback sentence.
   */
  signup?: boolean;
}

const { signup = true } = Astro.props;

const nav = await getNav('footer');
const { upcoming } = await getEventsForIndex();
const year = new Date().getFullYear();
const showNewsletter = signup && showSection('newsletter');

const socials = Object.entries(config.brand.social).filter(([, url]) => Boolean(url)) as Array<[string, string]>;
const socialLabels: Record<string, string> = { luma: 'Luma', linkedin: 'LinkedIn', x: 'X' };

/*
 * The footer carries the OPENING SENTENCE of the entity line, not the whole
 * paragraph. `brand.longDescription` was widened on 17 Oct 2026 to cover all
 * three bootcamps, which took it from four sentences to five and this block
 * from ten rendered lines to fifteen, on every page - a wall of boilerplate
 * where the footer's job is orientation. The full paragraph still runs in both
 * llms files and as the About hero subline, which is where an engine and a
 * reader actually want it.
 *
 * Derived rather than duplicated, so the two can never drift: whoever edits
 * `longDescription` edits this. Keep its first sentence self-contained - who,
 * what, where - and the footer stays right.
 */
const entityLine = `${config.brand.longDescription.split('. ')[0]}.`;
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    {
      /* Entity block — full brand name plus Oxford location, on every page.
         A consistent entity footprint is what AI engines triangulate on (PRD §13). */
    }
    <div class="site-footer__entity">
      <Wordmark />
      <p class="site-footer__desc">{entityLine}</p>
      <p class="site-footer__place">
        {config.brand.locality}, {config.brand.region}, United Kingdom
      </p>
    </div>

    <nav class="site-footer__col" aria-label="Footer">
      <h2 class="site-footer__label">Site</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        {/* The footer is the full site map: Team is listed here as well as in
            the header, so every section stays one click away from any page. */}
        {config.features.team && (
          <li>
            <a href={paths.team()}>Team</a>
          </li>
        )}
      </ul>
    </nav>

    {
      upcoming.length > 0 && (
        <div class="site-footer__col">
          <h2 class="site-footer__label">Upcoming</h2>
          <ul>
            {upcoming.map((event) => (
              <li>
                <a href={paths.event(event.data.slug)}>
                  {event.data.title}
                  <span class="site-footer__date">{formatShortDate(event.data.startDate)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="site-footer__col">
      <h2 class="site-footer__label">Elsewhere</h2>
      <ul>
        {socials.map(([key, url]) => <li><a href={url} rel="me noopener">{socialLabels[key] ?? key}</a></li>)}
        <li><a href={`mailto:${config.brand.email}`}><EmailAddress /></a></li>
      </ul>
    </div>
  </div>

  {
    /* Outside the grid on purpose. It spans every column, and `auto-fit` only
       collapses a track that nothing is placed in or spanning, so sitting in
       the grid kept a fifth, empty track alive from 1,100px up — three link
       columns squeezed into 159px with 207px of dead space beside them. */
    showNewsletter && (
      <div class="wrap">
        {/* The rule sits on the inner box so it still starts and ends where the
            wordmark above it does, rather than running out into the gutter. */}
        <div class="site-footer__signup">
          <NewsletterForm compact label="Hear about the next cohort first" />
        </div>
      </div>
    )
  }

  <div class="wrap site-footer__base">
    <p>© {year} {config.brand.name}</p>
    <p>{config.brand.tagline}</p>
    {/* Reachable from every page, which is the point: a cookie notice a visitor
        cannot find after dismissing the banner is not much of a notice. */}
    <p><a href="/privacy/">Privacy and cookies</a></p>
    {/* The application form lives here and nowhere else in the navigation, by
        Drummond's choice (23 Sept 2026): a page to send people to, not one that
        competes with the Luma booking path. */}
    <p><a href="/apply/">Apply for a place</a></p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-dark);
    color: var(--cream);
    border-block-start: 1px solid rgba(212, 175, 55, 0.2);
    padding-block: clamp(3rem, 2rem + 4vw, 4.5rem) 2rem;
  }

  .site-footer__grid {
    display: grid;
    gap: clamp(2rem, 1rem + 3vw, 3rem);
    /* min() on every track so the columns can collapse below their preferred
       width rather than forcing horizontal overflow at 320px. */
    grid-template-columns:
      minmax(min(100%, 15rem), 1.6fr)
      repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    align-items: start;
  }

  @media (max-width: 30rem) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .site-footer__desc {
    margin-block-start: 1.1rem;
    max-width: 34ch;
    font-size: var(--step-sm);
    color: var(--muted-on-dark);
    line-height: 1.55;
  }

  .site-footer__place {
    margin-block-start: 0.9rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--step-xs);
    color: var(--gold);
  }

  .site-footer__label {
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: var(--step-xs);
    color: var(--gold);
    margin-block-end: 1rem;
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__col li + li {
    margin-block-start: 0.55rem;
  }

  .site-footer__col a {
    color: var(--muted-on-dark);
    text-decoration: none;
    font-size: var(--step-sm);
    transition: color 200ms var(--ease);
  }

  .site-footer__col a:hover {
    color: var(--gold);
  }

  /* The same hairline underline the top nav draws, so the two navs answer a
     hover in one voice. Links carrying a date on a second line are excluded:
     an underline under the date would read as underlining the wrong thing. */
  .site-footer__col a:not(:has(.site-footer__date)) {
    background: linear-gradient(var(--gold), var(--gold)) no-repeat left bottom / 0 1px;
    padding-block-end: 0.1rem;
    transition: color 200ms var(--ease), background-size 220ms var(--ease);
  }

  .site-footer__col a:not(:has(.site-footer__date)):hover {
    background-size: 100% 1px;
  }

  .site-footer__col a:hover .site-footer__date {
    color: var(--gold);
  }

  .site-footer__date {
    display: block;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-on-dark-dim);
    margin-block-start: 0.15rem;
    transition: color 200ms var(--ease);
  }

  .site-footer__signup {
    /* The grid's own gap, so the band sits exactly where it did when it was a
       full-width row inside the grid. */
    margin-block-start: clamp(2rem, 1rem + 3vw, 3rem);
    padding-block-start: 2rem;
    border-block-start: 1px solid rgba(212, 175, 55, 0.16);
  }

  .site-footer__signup :global(.signup__input) {
    background: rgba(255, 249, 236, 0.08);
    border-color: rgba(212, 175, 55, 0.35);
    color: var(--cream);
  }

  .site-footer__signup :global(.signup__input::placeholder) {
    color: var(--muted-on-dark-dim);
  }

  .site-footer__signup :global(.signup__button) {
    background: var(--gold);
    color: var(--ink-dark);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-start: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-block-start: 1.5rem;
    border-block-start: 1px solid rgba(212, 175, 55, 0.16);
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: var(--step-xs);
    color: var(--muted-on-dark-dim);
  }
</style>

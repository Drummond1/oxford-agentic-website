---
/**
 * Back to top, for pages long enough to need it.
 *
 * Deliberately absent until it is useful: it appears once you are more than a
 * screen and a half down, which is far enough that scrolling back is a chore
 * and late enough that it never competes with the hero CTA. Fading it in on a
 * transform keeps it off the main thread and out of layout, so it cannot move
 * anything or cost CLS. Its gold edge fills with scroll progress, so it also
 * answers "how much is left".
 *
 * Sits below the consent banner in the stack rather than beside it. The banner
 * is dismissed once and this is permanent, so the overlap is brief and the
 * alternative — reserving space for a banner most visitors have already
 * dismissed — would leave a gap on every page forever.
 *
 * The booking bar is the other way round. It is permanent on the two pages
 * that take a booking, it lives in the same corner, and at z-index 60 against
 * this button's 50 it covered the button whole: measured at 375px and 768px on
 * both on-sale event pages, the arrow sat at 680-724 inside a bar occupying
 * 673-740, and a press at its centre landed on "Book". So on a phone this
 * control was drawn, announced and unreachable. It now clears the bar by the
 * same offset the assistant panel uses.
 */
---

<button type="button" class="to-top" data-to-top hidden aria-label="Back to top">
  <span class="to-top__arrow" aria-hidden="true">↑</span>
</button>

<script is:inline>
  (function () {
    var button = document.querySelector('[data-to-top]');
    if (!button) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // One passive, rAF-throttled scroll handler does both jobs: it shows the
    // button once you are more than a screen and a half down, and fills its
    // gold edge with how far down the page you are. (It replaced a 1px
    // sentinel and an IntersectionObserver, which never fired when a jump -
    // an anchor link, a keyboard End - skipped the sentinel past the viewport
    // in one step.) scrollHeight forces a reflow, so it is measured on resize
    // and cached; scrolling does arithmetic only.
    var max = 0;
    var ticking = false;
    var shown = false;

    function measure() {
      max = document.documentElement.scrollHeight - window.innerHeight;
    }

    function paint() {
      ticking = false;
      var y = window.scrollY;
      var past = y > window.innerHeight * 1.5;

      if (past !== shown) {
        shown = past;
        button.hidden = !past;
        // Toggled a frame later so the element is displayed before it animates,
        // otherwise the transition has nothing to run from.
        window.requestAnimationFrame(function () {
          button.classList.toggle('is-shown', past);
        });
      }

      if (past) {
        var p = max > 0 ? Math.min(Math.max(y / max, 0), 1) : 0;
        button.style.setProperty('--p', p.toFixed(3));
      }
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(paint);
    }

    measure();
    paint();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'resize',
      function () {
        measure();
        paint();
      },
      { passive: true },
    );

    button.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
      // Send focus back to the top of the document as well as the viewport —
      // scrolling alone would leave a keyboard user's place at the bottom.
      var skip = document.querySelector('.skip-link');
      if (skip instanceof HTMLElement) skip.focus({ preventScroll: true });
    });
  })();
</script>

<style>
  .to-top {
    position: fixed;
    inset-block-end: clamp(1rem, 0.5rem + 2vw, 2rem);
    inset-inline-end: clamp(1rem, 0.5rem + 2vw, 2rem);
    z-index: 50;

    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;

    /* The 1px edge is a conic gradient: gold for the fraction scrolled, the
       usual hairline for the rest. The ink face is a pseudo-element inset by
       that 1px, so the edge reads as a border that fills. */
    background: conic-gradient(var(--gold) calc(var(--p, 0) * 1turn), var(--gold-hairline) 0);
    color: var(--gold);
    border: 0;
    border-radius: 0;
    cursor: pointer;

    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 260ms var(--ease),
      transform 260ms var(--ease),
      background-color 200ms var(--ease),
      border-color 200ms var(--ease);
  }

  .to-top[hidden] {
    display: none;
  }

  .to-top.is-shown {
    opacity: 1;
    transform: translateY(0);
  }

  .to-top::before {
    content: '';
    position: absolute;
    inset: 1px;
    background: var(--ink-dark);
    transition: background-color 200ms var(--ease);
  }

  .to-top:hover {
    color: var(--ink-dark);
  }

  .to-top:hover::before {
    background: var(--gold);
  }

  .to-top__arrow {
    position: relative;
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 220ms var(--ease);
  }

  /* The arrow lifts a little on hover — the same nudge the event-card arrows
     use, pointing the way it will actually travel. */
  .to-top:hover .to-top__arrow {
    transform: translateY(-2px);
  }

  /* Event pages that are still selling carry a booking bar across the bottom
     of a phone screen, in this corner and above this button in the stack.
     Lift clear of it rather than sitting under it. Raising the z-index instead
     would put a 44px button on top of the Book button, which is worse. */
  @media (max-width: 48rem) {
    :global(body.has-sticky-bar) .to-top {
      inset-block-end: calc(4.25rem + env(safe-area-inset-bottom, 0px) + 0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .to-top,
    .to-top__arrow {
      transition: none;
    }

    .to-top {
      opacity: 1;
      transform: none;
    }
  }
</style>
